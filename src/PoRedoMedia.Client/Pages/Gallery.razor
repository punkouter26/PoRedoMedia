@* My media: the user's own uploads and results, with search, filters, bulk actions and the details
   panel. Shown by the Library page, which owns the address /gallery. *@
@implements IAsyncDisposable
@inject MediaApi Api
@inject RunTracker Tracker
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject ContextMenuService Menus
@inject NavigationManager Navigation
@inject IJSRuntime JS

<RadzenStack Gap="0.75rem">
    @* One bar: what is shown, or, once anything is ticked, what to do with the ticked items. *@
    @if (Picking)
    {
        <div class="po-page-bar gallery-bulk" role="toolbar" aria-label="Actions for the selected items">
            <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="Clear the selection" title="Clear the selection (Esc)"
                          Click="@(() => _picked = [])" />
            <RadzenText class="rz-m-0 gallery-bulk-count" aria-live="polite">@_picked.Count selected</RadzenText>
            <RadzenButton Text="Select all" Size="ButtonSize.Small" Variant="Variant.Text" Click="@(() => _picked = [.. Visible.Select(m => m.Id)])" />
            <span class="gallery-bulk-actions">
                <RadzenButton Text="Pin" Icon="push_pin" Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_working" Click="@(() => PinPickedAsync(true))" />
                <RadzenButton Text="Unpin" Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_working" Click="@(() => PinPickedAsync(false))" />
                <RadzenButton Text="Download" Icon="download" Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_working" Click="DownloadPickedAsync" />
                <RadzenButton Text="Delete" Icon="delete" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Disabled="_working" Click="DeletePickedAsync" />
            </span>
        </div>
    }
    else
    {
        <div class="po-page-bar">
            <div class="po-search">
                <RadzenIcon Icon="search" aria-hidden="true" />
                <RadzenTextBox Value="@_search" @oninput="@(e => SetAsync(search: e.Value?.ToString() ?? ""))" data-po-search
                               Placeholder="Search titles and words" aria-label="Search titles and words" title="Search (/)" />
            </div>
            <RadzenSelectBar Value="_kind" TValue="string" Change="@(v => SetAsync(kind: v))" Size="ButtonSize.Small" aria-label="Filter by kind" class="gallery-kinds">
                <Items>
                    <RadzenSelectBarItem Text="All" Value="@("All")" />
                    <RadzenSelectBarItem Text="Images" Value="@("Image")" />
                    <RadzenSelectBarItem Text="Videos" Value="@("Video")" />
                    <RadzenSelectBarItem Text="Audio" Value="@("Audio")" />
                </Items>
            </RadzenSelectBar>
            <RadzenButton Icon="sort" Text="@_sort" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@($"Sort: {_sort}")" title="Sort"
                          aria-haspopup="menu" Click="OpenSortMenu" class="gallery-sort" />
            <RadzenButton Text="Add media" Icon="add" Click="AddAsync" class="gallery-add po-phone-hide-text" />
        </div>
    }

    @if (_items is null)
    {
        <div class="gallery-grid" role="status" aria-label="Loading">
            @for (var i = 0; i < 12; i++)
            {
                <div class="po-skeleton gallery-skeleton"></div>
            }
        </div>
    }
    else if (_items.Count == 0)
    {
        <RadzenText>Nothing here yet. Add a photo or a video to get started.</RadzenText>
    }
    else
    {
        <div class="gallery-split @(Selected is not null ? "has-panel" : "") @(Picking ? "picking" : "")">
            <div class="gallery-grid">
                @foreach (var media in Visible)
                {
                    var item = media;
                    var picked = _picked.Contains(item.Id);
                    var on = Picking ? picked : item.Id == _selectedId;
                    <div class="gallery-card @(on ? "selected" : "")" data-id="@item.Id" @key="item.Id">
                        <button type="button" class="gallery-open" aria-pressed="@(on ? "true" : "false")" @onclick="@(() => ClickAsync(item))"
                                @oncontextmenu="@(e => OpenMenu(e, item))" @oncontextmenu:preventDefault>
                            @if (item.Kind == MediaKind.Audio)
                            {
                                <span class="gallery-thumb gallery-audio" aria-hidden="true"><RadzenIcon Icon="music_note" /></span>
                            }
                            else
                            {
                                <img class="gallery-thumb" src="@item.ThumbUrl" alt="" loading="lazy" />
                            }
                            <span class="gallery-title">@item.Title</span>
                            <span class="gallery-meta">
                                <RadzenBadge Text="@item.Kind.ToString()" BadgeStyle="BadgeStyle.Base" Shade="Shade.Darker" />
                                @if (item.Pinned)
                                {
                                    <RadzenIcon Icon="push_pin" title="Pinned" aria-label="Pinned" />
                                }
                                @if (item.Shared)
                                {
                                    <RadzenIcon Icon="link" title="Shared by link" aria-label="Shared by link" />
                                }
                            </span>
                        </button>
                        @* Ticking starts a selection; while there is one, a click on a card ticks it too. *@
                        <input type="checkbox" class="gallery-pick" checked="@picked" aria-label="@($"Select {item.Title}")"
                               @onchange="@(() => TogglePick(item.Id))" />
                    </div>
                }
            </div>
            @if (Selected is { } selected)
            {
                <MediaPanel @ref="_panel" @key="selected.Id" Media="selected" Family="_items"
                            Changed="OnChanged" Deleted="OnDeleted" Selected="@(m => SetAsync(selected: m.Id))" Closed="@(() => SetAsync(clearSelected: true))" />
            }
        </div>
        @if (!Visible.Any())
        {
            <RadzenText>Nothing matches. Clear the search or pick another kind.</RadzenText>
        }
    }
</RadzenStack>

@code {
    private static readonly string[] Sorts = ["Newest", "Oldest", "Name", "Largest"];
    private const int MaxZipItems = 50;
    private const long MaxZipBytes = 1024L * 1024 * 1024;

    // What is filtered, sorted and open lives in the address, so back, forward and refresh keep it.
    [SupplyParameterFromQuery] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public Guid? Item { get; set; }

    private List<MediaDto>? _items;
    private string _kind = "All";
    private string _search = "";
    private string _sort = "Newest";
    private Guid? _selectedId;
    private bool _working;
    private HashSet<Guid> _picked = [];
    private MediaPanel? _panel;
    private DotNetObjectReference<Gallery>? _self;
    private string _magnet = "";

    /// <summary>True while any card is ticked: clicks tick, and the bar shows the bulk actions.</summary>
    private bool Picking => _picked.Count > 0;

    private MediaDto? Selected => Picking ? null : _items?.FirstOrDefault(m => m.Id == _selectedId);

    private IEnumerable<MediaDto> Visible => Order(Filter(_items ?? [], _kind, _search), _sort);

    protected override async Task OnInitializedAsync()
    {
        Tracker.Finished += OnRunFinished;
        _items = await Api.ListAsync();
    }

    // A run that ends while the gallery is open puts its results at the top, without a refresh.
    private void OnRunFinished(TrackedRun run) => InvokeAsync(() =>
    {
        if (_items is null)
            return;

        _items.InsertRange(0, run.Outputs.Where(o => _items.All(m => m.Id != o.Id)).ToList());
        StateHasChanged();
    });

    protected override void OnParametersSet() =>
        (_kind, _search, _sort, _selectedId) = (Kind ?? "All", Q ?? "", Sorts.Contains(Sort) ? Sort! : "Newest", Item);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("poMedia.shortcuts", _self);
            // Cards tilt toward the pointer and can be thrown away (js/fx/shatter.js).
            await JS.InvokeVoidAsync("poShatter.attach", _self);
        }

        // The picked cards lean together, so a bulk action's selection reads as one group.
        var picked = _picked.Select(id => id.ToString()).Order().ToArray();
        var signature = string.Join(',', picked);
        if (signature != _magnet)
        {
            _magnet = signature;
            await JS.InvokeVoidAsync("poShatter.magnet", (object)picked);
        }
    }

    /// <summary>Matches the kind, and the search against the title, where it came from and its words.</summary>
    public static IEnumerable<MediaDto> Filter(IEnumerable<MediaDto> items, string kind, string search)
    {
        var words = search.Trim();
        return items.Where(m => kind == "All" || m.Kind.ToString() == kind)
            .Where(m => m.Title.Contains(words, StringComparison.OrdinalIgnoreCase)
                || m.Origin.Contains(words, StringComparison.OrdinalIgnoreCase)
                || m.Text?.Contains(words, StringComparison.OrdinalIgnoreCase) == true);
    }

    private static IEnumerable<MediaDto> Order(IEnumerable<MediaDto> items, string sort) => sort switch
    {
        "Oldest" => items.OrderBy(m => m.CreatedAt),
        "Name" => items.OrderBy(m => m.Title, StringComparer.OrdinalIgnoreCase),
        "Largest" => items.OrderByDescending(m => m.SizeBytes),
        _ => items.OrderByDescending(m => m.CreatedAt),
    };

    /// <summary>Changes one part of the view and writes the whole of it to the address.</summary>
    private Task SetAsync(string? kind = null, string? search = null, string? sort = null, Guid? selected = null, bool clearSelected = false)
    {
        (_kind, _search, _sort) = (kind ?? _kind, search ?? _search, sort ?? _sort);
        _selectedId = clearSelected ? null : selected ?? _selectedId;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["kind"] = _kind == "All" ? null : _kind,
            ["q"] = _search.Length == 0 ? null : _search,
            ["sort"] = _sort == "Newest" ? null : _sort,
            ["item"] = _selectedId,
        }), replace: true);
        return Task.CompletedTask;
    }

    private Task ClickAsync(MediaDto item)
    {
        if (!Picking)
            return SetAsync(selected: item.Id);

        TogglePick(item.Id);
        return Task.CompletedTask;
    }

    private void TogglePick(Guid id)
    {
        if (!_picked.Remove(id))
            _picked.Add(id);
    }

    private void OpenSortMenu(MouseEventArgs e) =>
        Menus.Open(e, [.. Sorts.Select(s => new ContextMenuItem { Text = s, Value = s, Icon = s == _sort ? "check" : "" })],
            args => InvokeAsync(async () =>
            {
                Menus.Close();
                await SetAsync(sort: args.Value as string);
                StateHasChanged();
            }));

    /// <summary>Opens the same picker Create uses, so the gallery takes drops, pastes and the camera too.</summary>
    private async Task AddAsync()
    {
        var added = await Dialogs.OpenAsync<MediaPicker>("Add media", new Dictionary<string, object?>
        {
            [nameof(MediaPicker.ShowRecent)] = false,
            [nameof(MediaPicker.ValueChanged)] = EventCallback.Factory.Create<MediaDto>(this, media => Dialogs.Close(media)),
        }, new DialogOptions { Width = "min(42rem, calc(100vw - 1rem))" });
        if (added is not MediaDto media)
            return;

        _items!.Insert(0, media);
        await SetAsync(selected: media.Id);
    }

    private void OnChanged(MediaDto updated)
    {
        var index = _items!.FindIndex(m => m.Id == updated.Id);
        if (index >= 0)
            _items[index] = updated;
    }

    private Task OnDeleted(MediaDto deleted)
    {
        _items!.RemoveAll(m => m.Id == deleted.Id);
        return SetAsync(clearSelected: true);
    }

    private async Task PinPickedAsync(bool pinned)
    {
        _working = true;
        foreach (var item in _items!.Where(m => _picked.Contains(m.Id) && m.Pinned != pinned).ToList())
        {
            if ((await Api.UpdateAsync(item.Id, null, pinned)).Media is { } updated)
                OnChanged(updated);
        }

        _working = false;
    }

    /// <summary>One item downloads as itself; several come as one ZIP.</summary>
    private async Task DownloadPickedAsync()
    {
        var picked = _items!.Where(m => _picked.Contains(m.Id)).ToList();
        // The server stops at 50 items, and a larger archive would not finish on the hosting plan.
        if (picked.Count > MaxZipItems || picked.Sum(m => m.SizeBytes) > MaxZipBytes)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Too much for one download", $"Pick up to {MaxZipItems} items and 1 GB at a time.", 8000);
            return;
        }

        await JS.InvokeVoidAsync("poMedia.download", picked.Count == 1 ? picked[0].Url + "?download=true" : $"api/media/zip?ids={string.Join(',', picked.Select(m => m.Id))}");
    }

    /// <summary>The right-click menu: the panel's actions without opening the panel first.</summary>
    private void OpenMenu(MouseEventArgs e, MediaDto item)
    {
        var items = new List<ContextMenuItem> { new() { Text = "Open", Value = "open", Icon = "open_in_full" } };
        if (item.Kind != MediaKind.Audio)
            items.Add(new() { Text = "Use as source", Value = "source", Icon = "play_arrow" });
        if (item.Kind == MediaKind.Image)
            items.Add(new() { Text = "Copy picture", Value = "copy", Icon = "content_copy" });
        items.Add(new() { Text = "Download", Value = "download", Icon = "download" });
        items.Add(new() { Text = item.Pinned ? "Unpin" : "Pin", Value = "pin", Icon = "push_pin" });
        items.Add(new() { Text = "Delete", Value = "delete", Icon = "delete" });
        Menus.Open(e, items, args => InvokeAsync(() => OnMenuAsync(args.Value as string, item)));
    }

    private async Task OnMenuAsync(string? action, MediaDto item)
    {
        Menus.Close();
        switch (action)
        {
            case "open":
                _picked = [];
                await SetAsync(selected: item.Id);
                break;
            case "source":
                Navigation.NavigateTo($"?source={item.Id}");
                break;
            case "copy":
                if (!await JS.InvokeAsync<bool>("poMedia.copyImage", item.Url))
                    Notifications.Notify(NotificationSeverity.Error, "Could not copy", "This browser did not allow a picture on the clipboard.", 8000);
                else
                    Notifications.Notify(NotificationSeverity.Success, "Copied", "The picture is on the clipboard.");
                break;
            case "download":
                await JS.InvokeVoidAsync("poMedia.download", item.Url + "?download=true");
                break;
            case "pin":
                if ((await Api.UpdateAsync(item.Id, null, !item.Pinned)).Media is { } updated)
                    OnChanged(updated);
                break;
            case "delete":
                // Only this card is deleted; a selection being built, or none, is put back afterwards.
                var kept = _picked;
                _picked = [item.Id];
                await DeletePickedAsync();
                _picked = [.. kept.Where(k => k != item.Id)];
                if (_selectedId == item.Id && _items!.All(m => m.Id != item.Id))
                    await SetAsync(clearSelected: true);
                break;
        }

        StateHasChanged();
    }

    private async Task DeletePickedAsync()
    {
        var count = _picked.Count;
        var confirmed = await Dialogs.Confirm(
            $"Delete {(count == 1 ? "1 item" : $"{count} items")}? This cannot be undone.", "Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Keep" });
        if (confirmed != true)
            return;

        _working = true;
        // The cards break into shards straight away; any that could not be deleted come back.
        var shattered = await JS.InvokeAsync<bool>("poShatter.burst", _picked.ToList());
        var failed = new List<Guid>();
        foreach (var id in _picked.ToList())
        {
            if (await Api.DeleteAsync(id) is null)
            {
                _items!.RemoveAll(m => m.Id == id);
                _picked.Remove(id);
            }
            else
            {
                failed.Add(id);
            }
        }

        _working = false;
        if (failed.Count > 0)
            await JS.InvokeVoidAsync("poShatter.restore", failed);
        if (!shattered)
            await JS.InvokeVoidAsync("poSfx.play", "remove");
        if (failed.Count > 0)
            Notifications.Notify(NotificationSeverity.Error, "Some items were kept", $"{failed.Count} could not be deleted. An item with a run in progress cannot be.", 8000);
    }

    /// <summary>Keyboard shortcuts, sent by the page script when no field has the focus.</summary>
    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        var visible = Visible.ToList();
        var at = visible.FindIndex(m => m.Id == _selectedId);
        switch (key)
        {
            case "ArrowRight" or "ArrowDown" when visible.Count > 0:
                await MoveAsync(visible[Math.Min(visible.Count - 1, at + 1)]);
                break;
            case "ArrowLeft" or "ArrowUp" when visible.Count > 0:
                await MoveAsync(visible[Math.Max(0, at - 1)]);
                break;
            case "Escape":
                if (Picking)
                    _picked = [];
                else
                    await SetAsync(clearSelected: true);
                break;
            case "Enter" when Selected is { Kind: not MediaKind.Audio } source:
                Navigation.NavigateTo($"?source={source.Id}");
                break;
            case "Delete" when _panel is not null && Selected is not null:
                await _panel.DeleteAsync();
                break;
            case "p" or "P" when _panel is not null && Selected is not null:
                await _panel.TogglePinAsync();
                break;
            case "c" or "C" when _panel is not null:
                _panel.ToggleCompare();
                break;
        }

        StateHasChanged();
    }

    /// <summary>A card was thrown off the grid: delete it, after the usual question. True when it was deleted.</summary>
    [JSInvokable]
    public async Task<bool> OnFling(string id)
    {
        if (!Guid.TryParse(id, out var flung) || _items?.Any(m => m.Id == flung) != true)
            return false;

        // A throw deletes only the thrown card; the selection being built is put back afterwards.
        var kept = _picked;
        _picked = [flung];
        await DeletePickedAsync();
        var deleted = _items.All(m => m.Id != flung);
        _picked = [.. kept.Where(k => k != flung)];
        if (deleted && _selectedId == flung)
            await SetAsync(clearSelected: true);
        StateHasChanged();
        return deleted;
    }

    private async Task MoveAsync(MediaDto item)
    {
        await SetAsync(selected: item.Id);
        await JS.InvokeVoidAsync("poMedia.scrollIntoView", $".gallery-card[data-id='{item.Id}']");
    }

    public async ValueTask DisposeAsync()
    {
        Tracker.Finished -= OnRunFinished;
        try
        {
            await JS.InvokeVoidAsync("poMedia.releaseShortcuts");
            await JS.InvokeVoidAsync("poShatter.detach");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away, and its listeners with it.
        }

        _self?.Dispose();
    }
}
