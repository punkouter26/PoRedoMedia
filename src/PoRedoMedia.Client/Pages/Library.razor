@page "/gallery"
@page "/sounds"
@page "/feed"
@page "/library"
@* Everything already made, in one place: your own media, the sound library and the shared feed.
   Each section keeps its own address, so links, bookmarks and the back button work as before. *@
@inject NavigationManager Navigation

<PageTitle>@Section · PoRedoMedia</PageTitle>

<div class="library-head">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Library</RadzenText>
    <nav class="library-tabs" aria-label="Library sections">
        @foreach (var (path, label, icon) in Sections)
        {
            <a href="@path" class="@(path == _path ? "active" : null)" aria-current="@(path == _path ? "page" : null)">
                <RadzenIcon Icon="@icon" aria-hidden="true" /><span>@label</span>
            </a>
        }
    </nav>
</div>

@switch (_path)
{
    case "sounds":
        <Sounds />
        break;
    case "feed":
        <Feed />
        break;
    default:
        <Gallery />
        break;
}

@code {
    private static readonly (string Path, string Label, string Icon)[] Sections =
    [
        ("gallery", "My media", "photo_library"),
        ("sounds", "Sounds", "graphic_eq"),
        ("feed", "Feed", "public"),
    ];

    private string _path = "gallery";

    private string Section => Sections.First(s => s.Path == _path).Label;

    // One page serves every section, so a change of section arrives here rather than as a new page.
    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#', '/')[0].ToLowerInvariant();
        if (path == "library")
        {
            Navigation.NavigateTo("gallery", replace: true);
            return;
        }

        _path = Sections.Any(s => s.Path == path) ? path : "gallery";
    }
}
