@page "/"
@using Radzen
@using Radzen.Blazor

<RadzenDataGrid Data="Rows" TItem="Row" AllowFiltering="true" AllowSorting="true">
    <Columns>
        <RadzenDataGridColumn TItem="Row" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="Row" Property="Kind" Title="Kind" />
    </Columns>
</RadzenDataGrid>

@code {
    // Spike for risk R2: a filtering grid must build under the trim analyzer.
    private sealed record Row(string Name, string Kind);

    private static readonly Row[] Rows = [new("beach.jpg", "Image"), new("party.mp4", "Video")];
}
