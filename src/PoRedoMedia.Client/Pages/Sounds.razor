@* The sound library Meme-ify picks from, as cards: play, star, its spectrogram and its tags.
   Shown by the Library page, which owns the address /sounds. *@
@using Microsoft.AspNetCore.Components.Forms
@inject SoundsApi Api
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject ContextMenuService Menus
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<RadzenStack Gap="0.75rem">
    <div class="po-page-bar">
        <div class="po-search">
            <RadzenIcon Icon="search" aria-hidden="true" />
            <RadzenTextBox Value="@_search" @oninput="@(e => Set(search: e.Value?.ToString() ?? ""))" data-po-search
                           Placeholder="Search names and tags" aria-label="Search names and tags" />
        </div>
        <div class="sounds-toggle">
            <RadzenSwitch Value="_starredOnly" Change="@(on => Set(starred: on))" Name="starred-only" />
            <RadzenLabel Component="starred-only" Text="Starred only" />
        </div>
        <RadzenButton Icon="sort" Text="@_sort" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@($"Sort: {_sort}")" title="Sort"
                      aria-haspopup="menu" Click="OpenSortMenu" class="sounds-sort" />
        <FilePick Text="@(_uploading ? "Adding…" : "Add a sound")" Icon="add" Accept=".mp3,.wav,.ogg" Disabled="_uploading" OnChange="UploadAsync" Class="po-phone-hide-text" @ref="_file" />
    </div>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Meme-ify picks from these, starred ones first. MP3, WAV or OGG up to 15 MB.</RadzenText>

    @* One player for the whole library: starting a sound stops the one before it. *@
    <audio @ref="_player" class="sounds-player" controls preload="none" aria-label="Sound player" hidden="@(_playing is null)"></audio>

    @* Every card carries a spectrogram of its sound, drawn by js/fx/spectro.js. *@
    <div @ref="_wall" class="sounds-wall">
    @if (_sounds is null)
    {
        <div role="status" aria-label="Loading" class="sounds-grid">
            @for (var i = 0; i < 8; i++)
            {
                <div class="po-skeleton sounds-skeleton"></div>
            }
        </div>
    }
    else
    {
        var shown = Order(Filter(_sounds, _search, _starredOnly), _sort).ToList();
        if (shown.Count == 0)
        {
            <RadzenText class="rz-m-0">No sounds match. The library is filled with the seed-sounds command.</RadzenText>
        }
        <ul class="sounds-grid" aria-label="Sounds">
            @foreach (var item in shown.Skip(_skip).Take(PageSize))
            {
                var sound = item;
                <li class="sound-card" @key="sound.SoundId">
                    <div class="sound-head">
                        <RadzenButton Icon="@(_playing == sound.SoundId ? "graphic_eq" : "play_arrow")" Variant="Variant.Filled" Size="ButtonSize.Small"
                                      class="sound-play" aria-label="@($"Play {sound.DisplayName}")" Click="@(() => PlayAsync(sound))" />
                        <span class="sound-name">@sound.DisplayName</span>
                        <span class="sound-length">@((sound.DurationMs / 1000.0).ToString("0.0")) s</span>
                        <RadzenButton Icon="@(sound.IsFavorite ? "star" : "star_border")" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@_busy.Contains(sound.SoundId)"
                                      class="@(sound.IsFavorite ? "sound-starred" : null)"
                                      aria-label="@(sound.IsFavorite ? $"Unstar {sound.DisplayName}" : $"Star {sound.DisplayName}")"
                                      aria-pressed="@(sound.IsFavorite ? "true" : "false")" Click="@(() => ToggleAsync(sound))" />
                        @if (sound.IsMine)
                        {
                            <RadzenButton Icon="delete" Variant="Variant.Text" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Disabled="@_busy.Contains(sound.SoundId)"
                                          aria-label="@($"Delete {sound.DisplayName}")" title="Delete this upload" Click="@(() => DeleteAsync(sound))" />
                        }
                    </div>
                    <canvas class="sounds-spectro sounds-spectro-cell" data-spectro="@StreamUrl(sound)" aria-hidden="true"
                            title="Click to play from here"></canvas>
                    <span class="sounds-tags">
                        @foreach (var tag in sound.ActionVectorTags)
                        {
                            <RadzenBadge Text="@tag" BadgeStyle="BadgeStyle.Base" Shade="Shade.Darker" IsPill="true" />
                        }
                    </span>
                </li>
            }
        </ul>
        @if (shown.Count > PageSize)
        {
            @* Keyed to what is shown, so a new search starts the pager again at page one. *@
            <RadzenPager @key="(_search, _starredOnly, _sort)" Count="shown.Count" PageSize="PageSize" PageNumbersCount="5" HorizontalAlign="HorizontalAlign.Center"
                         PageChanged="@(args => _skip = args.Skip)" class="sounds-pager" />
        }
    }
    </div>
</RadzenStack>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery] public bool? Starred { get; set; }

    private const int PageSize = 24;
    private static readonly string[] Sorts = ["Name", "Starred first", "Shortest", "Longest"];

    private List<SoundAssetDto>? _sounds;
    private string _search = "";
    private string _sort = "Name";
    private int _skip;
    private bool _starredOnly;
    private bool _uploading;
    private Guid? _playing;
    private readonly HashSet<Guid> _busy = [];
    private ElementReference _player;
    private ElementReference _wall;
    private FilePick? _file;
    private bool _attached;

    protected override async Task OnInitializedAsync() => _sounds = await Api.ListAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _attached = true;
        await JS.InvokeVoidAsync("poSpectro.attach", _wall, _player);
    }

    private static string StreamUrl(SoundAssetDto sound) => $"api/sounds/{sound.SoundId}/stream";

    protected override void OnParametersSet() => (_search, _starredOnly) = (Q ?? "", Starred == true);

    public static IEnumerable<SoundAssetDto> Filter(IEnumerable<SoundAssetDto> sounds, string search, bool starredOnly) =>
        sounds.Where(s => !starredOnly || s.IsFavorite)
              .Where(s => s.DisplayName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                       || s.ActionVectorTags.Any(t => t.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));

    private static IEnumerable<SoundAssetDto> Order(IEnumerable<SoundAssetDto> sounds, string sort) => sort switch
    {
        "Starred first" => sounds.OrderByDescending(s => s.IsFavorite).ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase),
        "Shortest" => sounds.OrderBy(s => s.DurationMs),
        "Longest" => sounds.OrderByDescending(s => s.DurationMs),
        _ => sounds.OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase),
    };

    private void OpenSortMenu(MouseEventArgs e) =>
        Menus.Open(e, [.. Sorts.Select(s => new ContextMenuItem { Text = s, Value = s, Icon = s == _sort ? "check" : "" })],
            args => InvokeAsync(() =>
            {
                Menus.Close();
                (_sort, _skip) = (args.Value as string ?? _sort, 0);
                StateHasChanged();
            }));

    // The search and the switch live in the address, so back, forward and refresh keep them.
    private void Set(string? search = null, bool? starred = null)
    {
        (_search, _starredOnly, _skip) = (search ?? _search, starred ?? _starredOnly, 0);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = _search.Length == 0 ? null : _search,
            ["starred"] = _starredOnly ? true : null,
        }), replace: true);
    }

    private async Task PlayAsync(SoundAssetDto sound)
    {
        _playing = sound.SoundId;
        await JS.InvokeVoidAsync("poMedia.playSound", _player, StreamUrl(sound));
    }

    private async Task ToggleAsync(SoundAssetDto sound)
    {
        // A second click while the first is still on its way would undo it.
        if (!_busy.Add(sound.SoundId))
            return;

        var error = await Api.SetFavoriteAsync(sound.SoundId, !sound.IsFavorite);
        _busy.Remove(sound.SoundId);
        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not change the star", error, 8000);
            return;
        }

        _sounds![_sounds.IndexOf(sound)] = new SoundAssetDto
        {
            SoundId = sound.SoundId, DisplayName = sound.DisplayName, DurationMs = sound.DurationMs,
            ActionVectorTags = sound.ActionVectorTags, Attribution = sound.Attribution, IsMine = sound.IsMine, IsFavorite = !sound.IsFavorite,
        };
    }

    private async Task DeleteAsync(SoundAssetDto sound)
    {
        var confirmed = await Dialogs.Confirm(
            $"Delete \"{sound.DisplayName}\"? This cannot be undone.", "Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Keep" });
        if (confirmed != true || !_busy.Add(sound.SoundId))
            return;

        var error = await Api.DeleteAsync(sound.SoundId);
        _busy.Remove(sound.SoundId);
        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not delete that sound", error, 8000);
            return;
        }

        _sounds!.Remove(sound);
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > SoundsApi.MaxUploadBytes)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not add that sound", "Sounds can be at most 15 MB.", 8000);
            return;
        }

        _uploading = true;
        var (sound, error) = await Api.UploadAsync(e.File);
        _uploading = false;
        await JS.InvokeVoidAsync("poMedia.clearFile", _file!.Element);
        if (sound is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not add that sound", error ?? "", 8000);
            return;
        }

        _sounds!.Insert(0, sound);
        Notifications.Notify(NotificationSeverity.Success, "Sound added", sound.DisplayName);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_attached)
            return;

        try
        {
            await JS.InvokeVoidAsync("poSpectro.detach");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away, and its observers with it.
        }
    }
}
