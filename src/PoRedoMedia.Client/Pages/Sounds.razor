@page "/sounds"
@using Microsoft.AspNetCore.Components.Forms
@inject SoundsApi Api
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Sounds · PoRedoMedia</PageTitle>

<RadzenStack Gap="0.75rem">
    <div class="sounds-bar">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Sounds</RadzenText>
        <RadzenTextBox Value="@_search" @oninput="@(e => Set(search: e.Value?.ToString() ?? ""))" data-po-search
                       Placeholder="Search names and tags" aria-label="Search names and tags" class="po-grow" />
        <div class="sounds-toggle">
            <RadzenSwitch Value="_starredOnly" Change="@(on => Set(starred: on))" Name="starred-only" />
            <RadzenLabel Component="starred-only" Text="Starred only" />
        </div>
        <FilePick Text="@(_uploading ? "Adding…" : "Add a sound")" Accept=".mp3,.wav,.ogg" Disabled="_uploading" OnChange="UploadAsync" @ref="_file" />
    </div>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Meme-ify picks from these. Starred sounds are preferred. MP3, WAV or OGG up to 15 MB.</RadzenText>

    @* One player for the whole library: starting a sound stops the one before it. *@
    <audio @ref="_player" class="sounds-player" controls preload="none" aria-label="Sound player" hidden="@(_playing is null)"></audio>

    @if (_sounds is null)
    {
        <div role="status" aria-label="Loading" class="sounds-skeletons">
            @for (var i = 0; i < 8; i++)
            {
                <div class="po-skeleton sounds-skeleton"></div>
            }
        </div>
    }
    else
    {
        <RadzenDataGrid Data="@Filter(_sounds, _search, _starredOnly)" TItem="SoundAssetDto" AllowPaging="true" PageSize="20" Density="Density.Compact"
                        AllowSorting="true" EmptyText="No sounds match. The library is filled with the seed-sounds command.">
            <Columns>
                <RadzenDataGridColumn TItem="SoundAssetDto" Title="Star" Width="4rem" Sortable="false">
                    <Template Context="sound">
                        <RadzenButton Icon="@(sound.IsFavorite ? "star" : "star_border")" Variant="Variant.Text" Disabled="@_busy.Contains(sound.SoundId)"
                                      aria-label="@(sound.IsFavorite ? $"Unstar {sound.DisplayName}" : $"Star {sound.DisplayName}")"
                                      aria-pressed="@(sound.IsFavorite ? "true" : "false")" Click="@(() => ToggleAsync(sound))" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SoundAssetDto" Property="DisplayName" Title="Name">
                    <Template Context="sound">
                        <span class="sounds-name">
                            <RadzenButton Icon="@(_playing == sound.SoundId ? "graphic_eq" : "play_arrow")" Variant="Variant.Text" Size="ButtonSize.Small"
                                          aria-label="@($"Play {sound.DisplayName}")" Click="@(() => PlayAsync(sound))" />
                            @sound.DisplayName
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SoundAssetDto" Title="Tags" Sortable="false">
                    <Template Context="sound">
                        <span class="sounds-tags">
                            @foreach (var tag in sound.ActionVectorTags)
                            {
                                <RadzenBadge Text="@tag" BadgeStyle="BadgeStyle.Base" Shade="Shade.Darker" IsPill="true" />
                            }
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SoundAssetDto" Property="DurationMs" Title="Length" Width="5.5rem">
                    <Template Context="sound">@((sound.DurationMs / 1000.0).ToString("0.0")) s</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery] public bool? Starred { get; set; }

    private List<SoundAssetDto>? _sounds;
    private string _search = "";
    private bool _starredOnly;
    private bool _uploading;
    private Guid? _playing;
    private readonly HashSet<Guid> _busy = [];
    private ElementReference _player;
    private FilePick? _file;

    protected override async Task OnInitializedAsync() => _sounds = await Api.ListAsync();

    protected override void OnParametersSet() => (_search, _starredOnly) = (Q ?? "", Starred == true);

    public static IEnumerable<SoundAssetDto> Filter(IEnumerable<SoundAssetDto> sounds, string search, bool starredOnly) =>
        sounds.Where(s => !starredOnly || s.IsFavorite)
              .Where(s => s.DisplayName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                       || s.ActionVectorTags.Any(t => t.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));

    // The search and the switch live in the address, so back, forward and refresh keep them.
    private void Set(string? search = null, bool? starred = null)
    {
        (_search, _starredOnly) = (search ?? _search, starred ?? _starredOnly);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = _search.Length == 0 ? null : _search,
            ["starred"] = _starredOnly ? true : null,
        }), replace: true);
    }

    private async Task PlayAsync(SoundAssetDto sound)
    {
        _playing = sound.SoundId;
        await JS.InvokeVoidAsync("poMedia.playSound", _player, $"api/sounds/{sound.SoundId}/stream");
    }

    private async Task ToggleAsync(SoundAssetDto sound)
    {
        // A second click while the first is still on its way would undo it.
        if (!_busy.Add(sound.SoundId))
            return;

        var error = await Api.SetFavoriteAsync(sound.SoundId, !sound.IsFavorite);
        _busy.Remove(sound.SoundId);
        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not change the star", error, 8000);
            return;
        }

        _sounds![_sounds.IndexOf(sound)] = new SoundAssetDto
        {
            SoundId = sound.SoundId, DisplayName = sound.DisplayName, DurationMs = sound.DurationMs,
            ActionVectorTags = sound.ActionVectorTags, Attribution = sound.Attribution, IsFavorite = !sound.IsFavorite,
        };
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > SoundsApi.MaxUploadBytes)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not add that sound", "Sounds can be at most 15 MB.", 8000);
            return;
        }

        _uploading = true;
        var (sound, error) = await Api.UploadAsync(e.File);
        _uploading = false;
        await JS.InvokeVoidAsync("poMedia.clearFile", _file!.Element);
        if (sound is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not add that sound", error ?? "", 8000);
            return;
        }

        _sounds!.Insert(0, sound);
        Notifications.Notify(NotificationSeverity.Success, "Sound added", sound.DisplayName);
    }
}
