@* A real link (it opens in a new tab, and is read as a link) that looks like a button. Styled in
   app.css from the theme's colours, not by borrowing Radzen's internal button classes. *@

<a href="@Href" class="@($"po-link-btn {(Filled ? "filled" : "outlined")} {(Small ? "small" : "")} {Class}")" @attributes="Attributes">
    @if (Icon is not null)
    {
        <RadzenIcon Icon="@Icon" aria-hidden="true" />
    }
    @Text
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Filled { get; set; } = true;
    [Parameter] public bool Small { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }
}
