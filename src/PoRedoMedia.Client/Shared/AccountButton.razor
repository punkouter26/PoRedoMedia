@* One button for everything about the user: name, look and sound, the advanced switches, sign out. *@

@* The accessible name starts with the visible name, so speech input can say what is shown. *@
<a href="settings" class="shell-account" aria-label="@(Name is null ? "Settings" : $"{Name}: account and settings")" title="@(Name is null ? "Settings" : "Account and settings")">
    @if (Name is null)
    {
        <RadzenIcon Icon="tune" aria-hidden="true" />
    }
    else
    {
        <span class="shell-avatar" aria-hidden="true">@PoRedoMedia.Client.Pages.Settings.Initial(Name)</span>
        <span class="shell-account-name">@Name</span>
    }
</a>

@code {
    [Parameter] public string? Name { get; set; }
}
