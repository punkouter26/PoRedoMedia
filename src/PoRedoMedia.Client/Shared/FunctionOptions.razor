@* The few settings each ticked function has. Values travel as the run's option dictionary. *@
@inject RunApi Runs

@if (Functions.Any(f => FunctionStack.KindOf(f) == MediaKind.Video))
{
    <RadzenFieldset Text="Video" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            @if (Functions.Contains(MediaFunction.Memeify))
            {
                <RadzenFormField Text="Meme-ify style">
                    <RadzenDropDown TValue="string" Data="Personas" Value="@(Get(RunOptions.VideoPersona) is { Length: > 0 } persona ? persona : "standard")"
                                    Change="@(v => Set(RunOptions.VideoPersona, v?.ToString() ?? ""))" />
                </RadzenFormField>
            }
            @if (Functions.Contains(MediaFunction.VideoRoast) && RoastVoices.Count > 0)
            {
                <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.VideoRoastVoice) is { Length: > 0 } voice ? voice : RoastVoices[0])"
                                 Change="@((string v) => Set(RunOptions.VideoRoastVoice, v))" aria-label="Roast voice">
                    <Items>
                        @foreach (var voice in RoastVoices)
                        {
                            <RadzenSelectBarItem Text="@($"{voice} voice")" Value="@voice" />
                        }
                    </Items>
                </RadzenSelectBar>
            }
            <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.VideoAspect) is { Length: > 0 } aspect ? aspect : "original")"
                             Change="@((string v) => Set(RunOptions.VideoAspect, v))" aria-label="Shape of the result">
                <Items>
                    <RadzenSelectBarItem Text="Original shape" Value="@("original")" />
                    <RadzenSelectBarItem Text="Tall 9:16" Value="@("9:16")" />
                    <RadzenSelectBarItem Text="Square 1:1" Value="@("1:1")" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.BulkStyles))
{
    <RadzenFieldset Text="Bulk styles" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenText class="rz-m-0">Each ticked style makes one picture. Untick the ones you don't want.</RadzenText>
            @for (var i = 0; i < _bulk.Count; i++)
            {
                var index = i;
                var name = $"bulk-{index}";
                <div class="bulk-row">
                    <input type="checkbox" id="@name" checked="@_bulkTicked[index]" @onchange="@(e => TickBulk(index, e.Value is true))" />
                    <label for="@name">@BulkPrompts.Title(_bulk[index])</label>
                </div>
            }
            <RadzenPanel AllowCollapse="true" Collapsed="true" Text="Edit the style prompts">
                <RadzenStack Gap="0.5rem" class="rz-mt-2">
                    @for (var i = 0; i < _bulk.Count; i++)
                    {
                        var index = i;
                        <RadzenTextArea Value="@_bulk[index]" Rows="4" MaxLength="@BulkPrompts.MaxLength" aria-label="@($"Style prompt {index + 1}")"
                                        Change="@(text => EditBulk(index, text))" Style="width: 100%" />
                    }
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenButton Text="Save as my styles" Variant="Variant.Outlined" Click="SaveBulkAsync" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" aria-live="polite">@_bulkSaved</RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenPanel>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.Restyle))
{
    <RadzenFieldset Text="Restyle" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenFormField Text="Style">
                <RadzenDropDown TValue="string" Data="StyleRecipeCatalog.All" ValueProperty="Id" TextProperty="Title"
                                AllowClear="true" Placeholder="None: recreate the picture as it is"
                                Value="@Get(RunOptions.RestyleStyle)" Change="@(v => Set(RunOptions.RestyleStyle, v?.ToString() ?? ""))" />
            </RadzenFormField>
            @if (StyleRecipeCatalog.All.FirstOrDefault(r => r.Id == Get(RunOptions.RestyleStyle)) is { } recipe)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@recipe.Category · @recipe.Description</RadzenText>
            }
            <RadzenFormField Text="Or describe a style in your own words">
                <RadzenTextBox Value="@Get(RunOptions.RestylePrompt)" MaxLength="400" aria-label="Style in your own words" Change="@(v => Set(RunOptions.RestylePrompt, v))" />
            </RadzenFormField>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.RapRoast))
{
    <RadzenFieldset Text="Rap roast" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.RoastStyle) is { Length: > 0 } style ? style : "Trap")"
                             Change="@((string v) => Set(RunOptions.RoastStyle, v))" aria-label="How it is performed">
                <Items>
                    <RadzenSelectBarItem Text="Trap" Value="@("Trap")" />
                    <RadzenSelectBarItem Text="Old school" Value="@("OldSchool")" />
                    <RadzenSelectBarItem Text="Stand-up" Value="@("StandUp")" />
                </Items>
            </RadzenSelectBar>
            <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.RoastIntensity) is { Length: > 0 } level ? level : "Roast")"
                             Change="@((string v) => Set(RunOptions.RoastIntensity, v))" aria-label="How hard it hits">
                <Items>
                    <RadzenSelectBarItem Text="Gentle" Value="@("Gentle")" />
                    <RadzenSelectBarItem Text="Roast" Value="@("Roast")" />
                    <RadzenSelectBarItem Text="Scorched" Value="@("Scorched")" />
                    <RadzenSelectBarItem Text="Nuclear" Value="@("Nuclear")" />
                </Items>
            </RadzenSelectBar>
            <div class="bulk-row">
                <RadzenSwitch Name="roast-explicit" Value="@(Get(RunOptions.RoastExplicit) == "true")"
                              Change="@(on => Set(RunOptions.RoastExplicit, on ? "true" : "false"))" />
                <RadzenLabel Component="roast-explicit" Text="Allow strong language" />
            </div>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.PhotoToVideo))
{
    <RadzenFieldset Text="Photo to video" class="rz-mt-2">
        <RadzenFormField Text="What should happen in the clip?" Style="width: 100%">
            <RadzenTextArea Value="@Get(RunOptions.VideoPrompt)" Rows="3" MaxLength="1200" aria-label="What should happen in the clip" Change="@(v => Set(RunOptions.VideoPrompt, v))" />
        </RadzenFormField>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2 rz-mb-0">Makes an 8-second clip with sound. It takes a few minutes.</RadzenText>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.MemeCaption))
{
    <RadzenFieldset Text="Meme caption" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenSelectBar TValue="string" Value="@Mode" Change="@((string mode) => Set(RunOptions.MemeMode, mode))" aria-label="Where the text comes from">
                <Items>
                    <RadzenSelectBarItem Text="AI writes it" Value="@RunOptions.MemeModeAi" />
                    <RadzenSelectBarItem Text="I'll type it" Value="@RunOptions.MemeModeText" />
                    <RadzenSelectBarItem Text="Template" Value="@RunOptions.MemeModeTemplate" />
                </Items>
            </RadzenSelectBar>

            @if (Mode == RunOptions.MemeModeText)
            {
                <RadzenFormField Text="Top text">
                    <RadzenTextBox Value="@Get(RunOptions.MemeTop)" MaxLength="120" aria-label="Top text" Change="@(v => Set(RunOptions.MemeTop, v))" />
                </RadzenFormField>
                <RadzenFormField Text="Bottom text">
                    <RadzenTextBox Value="@Get(RunOptions.MemeBottom)" MaxLength="120" aria-label="Bottom text" Change="@(v => Set(RunOptions.MemeBottom, v))" />
                </RadzenFormField>
            }
            else if (Mode == RunOptions.MemeModeTemplate)
            {
                <RadzenFormField Text="Template">
                    <RadzenDropDown TValue="string" Data="_templates" ValueProperty="Id" TextProperty="Name"
                                    Value="@Get(RunOptions.MemeTemplate)" Change="@(v => Set(RunOptions.MemeTemplate, v?.ToString() ?? ""))" />
                </RadzenFormField>
                @if (_templates.FirstOrDefault(t => t.Id == Get(RunOptions.MemeTemplate)) is { } template)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@template.Description</RadzenText>
                    @for (var i = 0; i < template.ZoneLabels.Length; i++)
                    {
                        var index = i;
                        <RadzenFormField Text="@template.ZoneLabels[index]">
                            <RadzenTextBox Value="@Get(RunOptions.MemeZone(index))" MaxLength="120" aria-label="@template.ZoneLabels[index]" Change="@(v => Set(RunOptions.MemeZone(index), v))" />
                        </RadzenFormField>
                    }
                }
            }
        </RadzenStack>
    </RadzenFieldset>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MediaFunction> Functions { get; set; } = [];
    [Parameter, EditorRequired] public Dictionary<string, string> Options { get; set; } = [];

    /// <summary>Voices the server can perform the video roast in.</summary>
    [Parameter] public IReadOnlyList<string> RoastVoices { get; set; } = [];

    private static readonly string[] Personas = ["standard", "brainrot", "mlg", "sitcom", "drama", "anime"];

    private List<MemeTemplateDto> _templates = [];
    private List<string> _bulk = [];
    private List<bool> _bulkTicked = [];
    private string _bulkSaved = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Functions.Contains(MediaFunction.BulkStyles) && _bulk.Count == 0)
        {
            _bulk = await Runs.GetBulkPromptsAsync();
            _bulkTicked = [.. _bulk.Select(_ => true)];
            WriteBulk();
        }
    }

    private void TickBulk(int index, bool on)
    {
        _bulkTicked[index] = on;
        WriteBulk();
    }

    private void EditBulk(int index, string text)
    {
        _bulk[index] = text;
        _bulkSaved = "";
        WriteBulk();
    }

    private async Task SaveBulkAsync() =>
        _bulkSaved = await Runs.SaveBulkPromptsAsync(_bulk) ?? "Saved.";

    // The run carries exactly the ticked prompts, as they are on screen.
    private void WriteBulk()
    {
        for (var i = 0; i < BulkPrompts.Count; i++)
            Options.Remove(RunOptions.BulkPrompt(i));
        var slot = 0;
        for (var i = 0; i < _bulk.Count; i++)
            if (_bulkTicked[i] && _bulk[i].Trim().Length > 0)
                Options[RunOptions.BulkPrompt(slot++)] = _bulk[i];
    }

    private string Mode => Get(RunOptions.MemeMode) is { Length: > 0 } mode ? mode : RunOptions.MemeModeAi;

    private string Get(string key) => Options.GetValueOrDefault(key, "");

    private async Task Set(string key, string value)
    {
        Options[key] = value;
        if (value == RunOptions.MemeModeTemplate && _templates.Count == 0)
            _templates = await Runs.GetMemeTemplatesAsync();
    }

    /// <summary>What still has to be filled in before these options can run, or null.</summary>
    public static string? Missing(IReadOnlyList<MediaFunction> functions, IReadOnlyDictionary<string, string> options)
    {
        if (functions.Contains(MediaFunction.BulkStyles) && !options.Keys.Any(k => k.StartsWith("BulkStyles.prompt", StringComparison.Ordinal)))
            return "Tick at least one style.";
        if (functions.Contains(MediaFunction.PhotoToVideo) && options.GetValueOrDefault(RunOptions.VideoPrompt, "").Trim().Length < 3)
            return "Describe what should happen in the video.";
        if (!functions.Contains(MediaFunction.MemeCaption))
            return null;

        string Value(string key) => options.GetValueOrDefault(key, "").Trim();
        return Value(RunOptions.MemeMode) switch
        {
            RunOptions.MemeModeText when Value(RunOptions.MemeTop).Length + Value(RunOptions.MemeBottom).Length == 0
                => "Type the top or the bottom text for the meme.",
            RunOptions.MemeModeTemplate when Value(RunOptions.MemeTemplate).Length == 0 => "Pick a meme template.",
            _ => null,
        };
    }
}
