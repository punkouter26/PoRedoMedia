@* The few settings each ticked function has. Values travel as the run's option dictionary. *@
@inject RunApi Runs

@if (Functions.Any(f => FunctionStack.KindOf(f) == MediaKind.Video))
{
    <RadzenFieldset Text="Video" AllowCollapse="true" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            @if (Functions.Contains(MediaFunction.Memeify))
            {
                <RadzenFormField Text="Meme-ify style">
                    <RadzenDropDown TValue="string" Data="Personas" Value="@(Get(RunOptions.VideoPersona) is { Length: > 0 } persona ? persona : "standard")"
                                    Change="@(v => Set(RunOptions.VideoPersona, v?.ToString() ?? ""))" />
                </RadzenFormField>
            }
            @if (Functions.Contains(MediaFunction.VideoRoast) && RoastVoices.Count > 0)
            {
                <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.VideoRoastVoice) is { Length: > 0 } voice ? voice : RoastVoices[0])"
                                 Change="@((string v) => Set(RunOptions.VideoRoastVoice, v))" aria-label="Roast voice">
                    <Items>
                        @foreach (var voice in RoastVoices)
                        {
                            <RadzenSelectBarItem Text="@($"{voice} voice")" Value="@voice" />
                        }
                    </Items>
                </RadzenSelectBar>
            }
            @if (Duration is > 3)
            {
                <div class="trim" role="group" aria-label="Trim">
                    <span>Trim · @Seconds(TrimStart) – @Seconds(TrimEnd) (@Seconds(TrimEnd - TrimStart))</span>
                    <label>
                        <span>Start</span>
                        <input type="range" min="0" max="@Invariant(Duration.Value)" step="0.5" value="@Invariant(TrimStart)" aria-label="Trim start"
                               @oninput="@(e => SetTrim(Parse(e.Value) ?? 0, TrimEnd, movedStart: true))" />
                    </label>
                    <label>
                        <span>End</span>
                        <input type="range" min="0" max="@Invariant(Duration.Value)" step="0.5" value="@Invariant(TrimEnd)" aria-label="Trim end"
                               @oninput="@(e => SetTrim(TrimStart, Parse(e.Value) ?? Duration.Value, movedStart: false))" />
                    </label>
                </div>
            }
            <RadzenSelectBar TValue="string" Value="@(Get(RunOptions.VideoAspect) is { Length: > 0 } aspect ? aspect : "original")"
                             Change="@((string v) => Set(RunOptions.VideoAspect, v))" aria-label="Shape of the result">
                <Items>
                    <RadzenSelectBarItem Text="Original shape" Value="@("original")" />
                    <RadzenSelectBarItem Text="Tall 9:16" Value="@("9:16")" />
                    <RadzenSelectBarItem Text="Square 1:1" Value="@("1:1")" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.BulkStyles))
{
    @* One card per style: tick it to draw it, edit it in place. An empty slot is simply not shown. *@
    <RadzenFieldset Text="Bulk styles" AllowCollapse="true" class="rz-mt-2">
        <div class="bulk">
            <div class="bulk-head">
                <span class="bulk-count" aria-live="polite">
                    @(BulkFilled == 0 ? "No styles" : $"{BulkSelected} of {BulkFilled} selected") · one picture each
                </span>
                <span class="bulk-tools">
                    @if (BulkFilled > 0)
                    {
                        <RadzenButton Text="@(BulkSelected == BulkFilled ? "None" : "All")" Size="ButtonSize.Small" Variant="Variant.Text"
                                      Click="SelectAllBulkAsync" title="@(BulkSelected == BulkFilled ? "Untick every style" : "Tick every style")" />
                        <RadzenButton Text="Clear" Icon="clear_all" Size="ButtonSize.Small" Variant="Variant.Text" Click="ClearBulkAsync"
                                      title="Remove every style, to write your own" />
                    }
                    <RadzenButton Text="Save as mine" Icon="bookmark" Size="ButtonSize.Small" Variant="Variant.Text" Click="SaveBulkAsync"
                                  Disabled="@(BulkFilled == 0)" title="Start with these styles next time" />
                </span>
            </div>
            @if (_bulkSaved.Length > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" aria-live="polite">@_bulkSaved</RadzenText>
            }

            @if (BulkFilled == 0 && _bulkEditing is null)
            {
                <div class="bulk-empty">
                    <span>No styles yet. Write your own, or start again from the built-in ten.</span>
                    <RadzenButton Text="Use the built-in ten" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="RestoreBulkAsync" />
                </div>
            }

            <ul class="bulk-list">
                @for (var i = 0; i < _bulk.Count; i++)
                {
                    var index = i;
                    var editing = _bulkEditing == index;
                    if (!editing && _bulk[index].Trim().Length == 0)
                        continue;
                    var (title, body) = SplitBulk(_bulk[index]);
                    var name = title.Length > 0 ? title : "Untitled style";
                    <li class="@($"bulk-card {(_bulkTicked[index] ? "on" : "")} {(editing ? "editing" : "")}")" @key="index">
                        @if (editing)
                        {
                            <RadzenTextBox Value="@title" MaxLength="58" Placeholder="Name, e.g. The Film Noir Still" aria-label="Style name"
                                           Change="@(v => EditBulk(index, JoinBulk(v, body)))" class="po-fill" />
                            <RadzenTextArea Value="@body" Rows="5" MaxLength="@BulkPrompts.MaxLength" aria-label="What the style looks like"
                                            Placeholder="@($"Describe the look. Write {BulkPrompts.SubjectToken} where the person or thing in the picture goes.")"
                                            Change="@(v => EditBulk(index, JoinBulk(title, v)))" class="po-fill" />
                            <span class="bulk-card-actions">
                                <RadzenButton Text="Done" Size="ButtonSize.Small" Click="@(() => _bulkEditing = null)" />
                            </span>
                        }
                        else
                        {
                            <label class="bulk-pick">
                                <input type="checkbox" checked="@_bulkTicked[index]" @onchange="@(e => TickBulk(index, e.Value is true))" />
                                <span class="bulk-text">
                                    <strong>@name</strong>
                                    @if (body.Length > 0)
                                    {
                                        <span class="bulk-desc">@body.Replace(BulkPrompts.SubjectToken, "the subject", StringComparison.Ordinal)</span>
                                    }
                                </span>
                            </label>
                            <span class="bulk-card-actions">
                                <RadzenButton Icon="edit" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                              aria-label="@($"Edit {name}")" title="Edit" Click="@(() => _bulkEditing = index)" />
                                <RadzenButton Icon="close" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                              aria-label="@($"Remove {name}")" title="Remove" Click="@(() => EditBulk(index, ""))" />
                            </span>
                        }
                    </li>
                }
            </ul>

            @if (_bulkEditing is null && BulkFilled < BulkPrompts.Count)
            {
                <RadzenButton Text="Add a style" Icon="add" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="AddBulk" class="bulk-add" />
            }
        </div>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.Restyle))
{
    <RadzenFieldset Text="Restyle" AllowCollapse="true" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenFormField Text="Style">
                <RadzenDropDown TValue="string" Data="StyleRecipeCatalog.All" ValueProperty="Id" TextProperty="Title"
                                AllowClear="true" Placeholder="None: recreate the picture as it is"
                                Value="@Get(RunOptions.RestyleStyle)" Change="@(v => Set(RunOptions.RestyleStyle, v?.ToString() ?? ""))" />
            </RadzenFormField>
            @if (StyleRecipeCatalog.All.FirstOrDefault(r => r.Id == Get(RunOptions.RestyleStyle)) is { } recipe)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@recipe.Category · @recipe.Description</RadzenText>
            }
            <RadzenFormField Text="Or describe a style in your own words">
                <RadzenTextBox Value="@Get(RunOptions.RestylePrompt)" MaxLength="400" aria-label="Style in your own words" Change="@(v => Set(RunOptions.RestylePrompt, v))" />
            </RadzenFormField>
        </RadzenStack>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.PhotoToVideo))
{
    <RadzenFieldset Text="Photo to video" AllowCollapse="true" class="rz-mt-2">
        <RadzenFormField Text="What should happen in the clip?" class="po-fill">
            <RadzenTextArea Value="@Get(RunOptions.VideoPrompt)" Rows="3" MaxLength="1200" aria-label="What should happen in the clip" Change="@(v => Set(RunOptions.VideoPrompt, v))" />
        </RadzenFormField>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2 rz-mb-0">Makes an 8-second clip with sound. It takes a few minutes.</RadzenText>
    </RadzenFieldset>
}

@if (Functions.Contains(MediaFunction.MemeCaption))
{
    <RadzenFieldset Text="Meme caption" AllowCollapse="true" class="rz-mt-2">
        <RadzenStack Gap="0.75rem">
            <RadzenSelectBar TValue="string" Value="@Mode" Change="@((string mode) => Set(RunOptions.MemeMode, mode))" aria-label="Where the text comes from">
                <Items>
                    <RadzenSelectBarItem Text="AI writes it" Value="@RunOptions.MemeModeAi" />
                    <RadzenSelectBarItem Text="I'll type it" Value="@RunOptions.MemeModeText" />
                    <RadzenSelectBarItem Text="Template" Value="@RunOptions.MemeModeTemplate" />
                </Items>
            </RadzenSelectBar>

            @if (Mode == RunOptions.MemeModeText)
            {
                <RadzenFormField Text="Top text">
                    <RadzenTextBox Value="@Get(RunOptions.MemeTop)" MaxLength="120" aria-label="Top text" Change="@(v => Set(RunOptions.MemeTop, v))" />
                </RadzenFormField>
                <RadzenFormField Text="Bottom text">
                    <RadzenTextBox Value="@Get(RunOptions.MemeBottom)" MaxLength="120" aria-label="Bottom text" Change="@(v => Set(RunOptions.MemeBottom, v))" />
                </RadzenFormField>
            }
            else if (Mode == RunOptions.MemeModeTemplate)
            {
                <RadzenFormField Text="Template">
                    <RadzenDropDown TValue="string" Data="_templates" ValueProperty="Id" TextProperty="Name"
                                    Value="@Get(RunOptions.MemeTemplate)" Change="@(v => Set(RunOptions.MemeTemplate, v?.ToString() ?? ""))" />
                </RadzenFormField>
                @if (_templates.FirstOrDefault(t => t.Id == Get(RunOptions.MemeTemplate)) is { } template)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@template.Description</RadzenText>
                    @for (var i = 0; i < template.ZoneLabels.Length; i++)
                    {
                        var index = i;
                        <RadzenFormField Text="@template.ZoneLabels[index]">
                            <RadzenTextBox Value="@Get(RunOptions.MemeZone(index))" MaxLength="120" aria-label="@template.ZoneLabels[index]" Change="@(v => Set(RunOptions.MemeZone(index), v))" />
                        </RadzenFormField>
                    }
                }
            }
        </RadzenStack>
    </RadzenFieldset>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MediaFunction> Functions { get; set; } = [];
    [Parameter, EditorRequired] public Dictionary<string, string> Options { get; set; } = [];

    /// <summary>Voices the server can perform the video roast in.</summary>
    [Parameter] public IReadOnlyList<string> RoastVoices { get; set; } = [];

    /// <summary>True when on-device AI is switched on in Settings: the device choices are offered.</summary>
    [Parameter] public bool OnDevice { get; set; }

    /// <summary>Length of the picked video in seconds. The trim sliders show when it is known and long enough.</summary>
    [Parameter] public double? Duration { get; set; }

    /// <summary>Raised when an option changes, so the page can update what depends on it (the cost).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] Personas = ["standard", "brainrot", "mlg", "sitcom", "drama", "anime"];

    private List<MemeTemplateDto> _templates = [];
    private List<string> _bulk = [];
    private List<bool> _bulkTicked = [];
    private string _bulkSaved = "";
    private int? _bulkEditing;

    protected override async Task OnParametersSetAsync()
    {
        if (Functions.Contains(MediaFunction.BulkStyles) && _bulk.Count == 0)
        {
            _bulk = await Runs.GetBulkPromptsAsync();
            _bulkTicked = [.. _bulk.Select(_ => true)];
            WriteBulk();
            await Changed.InvokeAsync();
        }

        // A recipe can arrive already set to a template, without passing through Set.
        if (Functions.Contains(MediaFunction.MemeCaption) && Mode == RunOptions.MemeModeTemplate && _templates.Count == 0)
            _templates = await Runs.GetMemeTemplatesAsync();
    }

    private Task TickBulk(int index, bool on)
    {
        _bulkTicked[index] = on;
        WriteBulk();
        return Changed.InvokeAsync();
    }

    private Task EditBulk(int index, string text)
    {
        _bulk[index] = text;
        _bulkSaved = "";
        WriteBulk();
        return Changed.InvokeAsync();
    }

    private int BulkFilled => _bulk.Count(p => p.Trim().Length > 0);

    private int BulkSelected => _bulk.Where((p, i) => _bulkTicked[i] && p.Trim().Length > 0).Count();

    /// <summary>Removes every style, so the user can write their own.</summary>
    private Task ClearBulkAsync()
    {
        _bulk = [.. _bulk.Select(_ => "")];
        _bulkTicked = [.. _bulk.Select(_ => true)];
        _bulkSaved = "";
        _bulkEditing = null;
        WriteBulk();
        return Changed.InvokeAsync();
    }

    private Task RestoreBulkAsync()
    {
        _bulk = [.. BulkPrompts.All];
        _bulkTicked = [.. _bulk.Select(_ => true)];
        _bulkSaved = "";
        WriteBulk();
        return Changed.InvokeAsync();
    }

    /// <summary>Ticks every style, or unticks them all when they already are.</summary>
    private Task SelectAllBulkAsync()
    {
        var on = BulkSelected != BulkFilled;
        _bulkTicked = [.. _bulk.Select(_ => on)];
        WriteBulk();
        return Changed.InvokeAsync();
    }

    /// <summary>Opens the first empty slot, ticked, for a new style.</summary>
    private void AddBulk()
    {
        var index = _bulk.FindIndex(p => p.Trim().Length == 0);
        if (index < 0)
        {
            _bulk.Add("");
            _bulkTicked.Add(true);
            index = _bulk.Count - 1;
        }

        _bulkTicked[index] = true;
        _bulkEditing = index;
    }

    /// <summary>A prompt's name (the words before its first colon) and its description.</summary>
    private static (string Title, string Body) SplitBulk(string prompt) =>
        prompt.IndexOf(':') is > 0 and < 60 and var colon
            ? (prompt[..colon].Trim(), prompt[(colon + 1)..].Trim())
            : ("", prompt.Trim());

    private static string JoinBulk(string? title, string? body) =>
        (title?.Trim() ?? "", body?.Trim() ?? "") switch
        {
            ("", var b) => b,
            (var t, "") => t + ":",
            (var t, var b) => $"{t}: {b}",
        };

    private async Task SaveBulkAsync() =>
        _bulkSaved = await Runs.SaveBulkPromptsAsync(_bulk) ?? "Saved.";

    // The run carries exactly the ticked prompts, as they are on screen.
    private void WriteBulk()
    {
        for (var i = 0; i < BulkPrompts.Count; i++)
            Options.Remove(RunOptions.BulkPrompt(i));
        var slot = 0;
        for (var i = 0; i < _bulk.Count; i++)
            if (_bulkTicked[i] && _bulk[i].Trim().Length > 0)
                Options[RunOptions.BulkPrompt(slot++)] = _bulk[i];
    }

    private double TrimStart => Math.Clamp(Parse(Get(RunOptions.VideoTrimStart)) ?? 0, 0, Duration ?? 0);

    private double TrimEnd => Math.Clamp(Parse(Get(RunOptions.VideoTrimEnd)) ?? Duration ?? 0, 0, Duration ?? 0);

    private static double? Parse(object? value) =>
        double.TryParse(value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var number) ? number : null;

    private static string Invariant(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Seconds(double value) => $"{value:0.#}s";

    /// <summary>Keeps the two ends at least a second apart by pushing the one that was not moved.</summary>
    private Task SetTrim(double start, double end, bool movedStart)
    {
        var length = Duration ?? 0;
        if (end - start < 1)
        {
            if (movedStart)
                (start, end) = (Math.Min(start, length - 1), Math.Min(start, length - 1) + 1);
            else
                (start, end) = (Math.Max(end, 1) - 1, Math.Max(end, 1));
        }

        // The whole video is the absence of a trim, so nothing rides along with the run for it.
        if (start <= 0 && end >= length)
        {
            Options.Remove(RunOptions.VideoTrimStart);
            Options.Remove(RunOptions.VideoTrimEnd);
        }
        else
        {
            Options[RunOptions.VideoTrimStart] = Invariant(start);
            Options[RunOptions.VideoTrimEnd] = Invariant(end);
        }

        return Changed.InvokeAsync();
    }

    private string Mode => Get(RunOptions.MemeMode) is { Length: > 0 } mode ? mode : RunOptions.MemeModeAi;

    private string Get(string key) => Options.GetValueOrDefault(key, "");

    private async Task Set(string key, string value)
    {
        Options[key] = value;
        if (value == RunOptions.MemeModeTemplate && _templates.Count == 0)
            _templates = await Runs.GetMemeTemplatesAsync();
        await Changed.InvokeAsync();
    }

    /// <summary>What still has to be filled in before these options can run, or null.</summary>
    public static string? Missing(IReadOnlyList<MediaFunction> functions, IReadOnlyDictionary<string, string> options) =>
        // Only the page insists on a ticked style: a request with none uses the saved set.
        functions.Contains(MediaFunction.BulkStyles) && !options.Keys.Any(k => k.StartsWith("BulkStyles.prompt", StringComparison.Ordinal))
            ? "Type or tick at least one style."
            : FunctionStack.MissingOption(functions, options);
}
