@* Live state of one run: the step it is on, each result as it arrives, and how it ended. *@
@implements IAsyncDisposable
@inject RunApi Runs

<RadzenStack Gap="0.75rem">
    @if (_status is RunStatus.Queued or RunStatus.Running)
    {
        <RadzenProgressBar Value="_percent" Mode="@(_percent == 0 ? ProgressBarMode.Indeterminate : ProgressBarMode.Determinate)"
                           ShowValue="false" aria-label="Run progress" />
        <RadzenText class="rz-m-0" aria-live="polite">@_message</RadzenText>
    }
    else if (_status == RunStatus.Complete)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" class="rz-m-0" Style="color: #16181D">Done. The results are in your gallery.</RadzenAlert>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">
            @_message
            @if (_outputs.Count > 0)
            {
                <span> The results made before that were kept.</span>
            }
        </RadzenAlert>
    }

    @foreach (var note in _notes)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-m-0">@note</RadzenAlert>
    }

    <div class="run-results">
        @foreach (var output in _outputs)
        {
            <figure class="run-result" data-origin="@output.Origin">
                @switch (output.Kind)
                {
                    case MediaKind.Image:
                        <img src="@output.Url" alt="@output.Title" />
                        break;
                    case MediaKind.Video:
                        <video src="@output.Url" controls preload="metadata" aria-label="@output.Title"></video>
                        break;
                    default:
                        <audio src="@output.Url" controls aria-label="@output.Title"></audio>
                        break;
                }
                <figcaption>@output.Title</figcaption>
                @if (output.Kind == MediaKind.Video && Run.Functions.Contains(MediaFunction.Captions))
                {
                    <a href="@($"api/media/{output.Id}/captions.srt")" download="captions.srt">Download the captions (SRT)</a>
                }
                @if (output.Text is not null)
                {
                    <pre class="media-text">@output.Text</pre>
                }
            </figure>
        }
    </div>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public RunDto Run { get; set; } = null!;

    /// <summary>Raised once, when the run ends either way.</summary>
    [Parameter] public EventCallback<RunStatus> Finished { get; set; }

    [Inject] private MediaApi Media { get; set; } = null!;

    private readonly List<MediaDto> _outputs = [];
    private IReadOnlyList<string> _notes = [];
    private RunStatus _status = RunStatus.Queued;
    private double _percent;
    private string _message = "Waiting to start";
    private IAsyncDisposable? _subscription;
    private bool _finished;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _subscription = await Runs.FollowAsync(Run.Id, OnProgressAsync, ResyncAsync);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            // No live updates. The run is already started and paid for, so fall back to asking.
            _ = PollAsync();
        }

        // The run may have moved on, or finished, before the subscription was in place.
        await ResyncAsync();
    }

    private Task ResyncAsync() => InvokeAsync(async () =>
    {
        if (!_finished && await Runs.GetAsync(Run.Id) is { } current)
        {
            await ApplyAsync(current);
            StateHasChanged();
        }
    });

    private async Task PollAsync()
    {
        while (!_finished && !_disposed)
        {
            await Task.Delay(TimeSpan.FromSeconds(3));
            await ResyncAsync();
        }
    }

    private Task OnProgressAsync(RunProgressDto progress) => InvokeAsync(async () =>
    {
        if (_finished)
            return;

        (_status, _percent, _message) = (progress.Status, progress.Percent, progress.Message);
        if (progress.Output is { } output && _outputs.All(o => o.Id != output.Id))
            _outputs.Add(output);
        if (progress.Status is RunStatus.Complete or RunStatus.Failed && await Runs.GetAsync(Run.Id) is { } final)
            await ApplyAsync(final);
        StateHasChanged();
    });

    private async Task ApplyAsync(RunDto run)
    {
        _status = run.Status;
        _notes = run.Notes;
        if (run.Error is not null)
            _message = run.Error;

        if (run.OutputIds.Any(id => _outputs.All(o => o.Id != id)))
        {
            var gallery = await Media.ListAsync();
            _outputs.AddRange(run.OutputIds.Where(id => _outputs.All(o => o.Id != id)).Select(id => gallery.FirstOrDefault(m => m.Id == id)).OfType<MediaDto>());
        }

        if (run.Status is RunStatus.Complete or RunStatus.Failed && !_finished)
        {
            _finished = true;
            await Finished.InvokeAsync(run.Status);
        }
    }

    private bool _disposed;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_subscription is not null)
            await _subscription.DisposeAsync();
    }
}
