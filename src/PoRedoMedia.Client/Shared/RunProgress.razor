@* Live state of one run: each function as a step, each result as it arrives, and how it ended.
   The state itself is kept by RunTracker, so it survives leaving and returning to the page. *@
@implements IDisposable
@inject RunTracker Tracker

<RadzenStack Gap="0.75rem">
    <ol class="run-steps" aria-label="Steps">
        @foreach (var function in Run.Run.Functions)
        {
            var state = StateOf(function);
            <li class="run-step @state">
                <RadzenIcon Icon="@IconOf(state)" aria-hidden="true" />
                <span>@FunctionStack.Label(function)</span>
            </li>
        }
    </ol>

    @if (!Run.Finished)
    {
        <RadzenProgressBar Value="Run.Percent" Mode="@(Run.Percent == 0 ? ProgressBarMode.Indeterminate : ProgressBarMode.Determinate)"
                           ShowValue="false" aria-label="Run progress" />
        <RadzenText class="rz-m-0" aria-live="polite">@Run.Message</RadzenText>
    }
    else if (Run.Status == RunStatus.Complete)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" class="rz-m-0 po-alert-ink">Done. The results are in your gallery.</RadzenAlert>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">
            @Run.Message
            @if (Run.Outputs.Count > 0)
            {
                <span> The results made before that were kept.</span>
            }
        </RadzenAlert>
    }

    @if (Run.Log.Count > 1)
    {
        <details class="run-log" open="@(!Run.Finished)">
            <summary>Log (@Run.Log.Count)</summary>
            @* The box's flow is reversed in the stylesheet, so it stays scrolled to the newest line. *@
            <div class="run-log-lines" role="log" aria-label="What the run has done so far" tabindex="0">
                <ol>
                    @foreach (var line in Run.Log)
                    {
                        <li class="@(line.StartsWith("HIT #", StringComparison.Ordinal) || line.StartsWith("ROAST @", StringComparison.Ordinal) ? "run-log-cue" : null)">@line</li>
                    }
                </ol>
            </div>
        </details>
    }

    @foreach (var note in Run.Notes)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-m-0">@note</RadzenAlert>
    }

    <div class="run-results">
        @foreach (var output in Run.Outputs)
        {
            <figure class="run-result po-pop" data-origin="@output.Origin" @key="output.Id">
                @if (output.Kind == MediaKind.Audio && output.Text is not null)
                {
                    <RoastStage Media="output" />
                }
                else
                {
                    <MediaView Media="output" />
                }
                <figcaption>@output.Title</figcaption>
                @if (output.Kind == MediaKind.Video && Run.Run.Functions.Contains(MediaFunction.Captions))
                {
                    <a href="@($"api/media/{output.Id}/captions.srt")" download="captions.srt">Download the captions (SRT)</a>
                }
                @if (output.Kind == MediaKind.Video && output.Text is not null)
                {
                    <a href="@($"api/media/{output.Id}/roast-audio")" download>Download the roast alone (audio)</a>
                }
                @if (output.Kind != MediaKind.Audio && output.Text is not null)
                {
                    <pre class="media-text" tabindex="0">@output.Text</pre>
                }
            </figure>
        }
    </div>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public TrackedRun Run { get; set; } = null!;

    protected override void OnInitialized() => Tracker.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    /// <summary>Where one function stands: done, now, failed or waiting.</summary>
    private string StateOf(MediaFunction function)
    {
        if (Run.Status == RunStatus.Complete)
            return "done";

        var functions = Run.Run.Functions;
        var at = Run.Step is { } step ? Array.IndexOf(functions, step) : -1;
        var index = Array.IndexOf(functions, function);
        if (at < 0)
            return "waiting";
        if (index < at)
            return "done";
        return index > at ? "waiting" : Run.Status == RunStatus.Failed ? "failed" : "now";
    }

    private static string IconOf(string state) => state switch
    {
        "done" => "check_circle",
        "now" => "progress_activity",
        "failed" => "error",
        _ => "radio_button_unchecked",
    };

    public void Dispose() => Tracker.Changed -= Refresh;
}
