@* One gallery item in detail: what it is, where it came from, and what can be done with it. *@
@inject MediaApi Api
@inject AppConfigService Config
@inject DialogService Dialogs
@inject ContextMenuService Menus
@inject NotificationService Notifications
@inject IJSRuntime JS

<aside class="media-panel" aria-label="Details">
<RadzenCard class="po-pop po-glass">
    <RadzenStack Gap="0.75rem">
        <div class="panel-head">
            <RadzenFormField Text="Title" class="po-grow">
                <RadzenTextBox @bind-Value="_title" MaxLength="120" aria-label="Title" Change="@(_ => SaveAsync(_title, null))" />
            </RadzenFormField>
            <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="Close the details" title="Close (Esc)"
                          Click="@(() => Closed.InvokeAsync())" />
        </div>

        @if (Media.Kind == MediaKind.Audio && Media.Text is not null)
        {
            <RoastStage Media="Media" />
        }
        else if (_comparing && Before is { } before)
        {
            <CompareSlider Before="before" After="Media" />
        }
        else
        {
            <MediaView Media="Media" Class="media-preview" />
            @if (Media.Text is not null)
            {
                <pre class="media-text" tabindex="0">@Media.Text</pre>
            }
        }

        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
            @Media.Origin · @Media.CreatedAt.LocalDateTime.ToString("d MMM yyyy") · @Size(Media.SizeBytes)
            @if (Media.Pinned)
            {
                <span> · pinned</span>
            }
            else if (Expiry is { } expiry)
            {
                <span> · @expiry</span>
            }
        </RadzenText>

        @* One way forward, the everyday actions as icons, and the rest behind "More". *@
        <div class="panel-actions">
            @if (Media.Kind != MediaKind.Audio)
            {
                <LinkButton Href="@($"?source={Media.Id}")" Text="Use as source" Icon="play_arrow" />
            }
            <span class="panel-icons">
                @if (Before is not null)
                {
                    <RadzenButton Icon="compare" Variant="@(_comparing ? Variant.Filled : Variant.Text)" Click="ToggleCompare"
                                  aria-label="Compare" title="Before and after, with a slider (C)" aria-pressed="@(_comparing ? "true" : "false")" />
                }
                <RadzenButton Icon="download" Variant="Variant.Text" aria-label="Download" title="Download"
                              Click="@(() => JS.InvokeVoidAsync("poMedia.download", Media.Url + "?download=true"))" />
                <RadzenButton Icon="link" Variant="@(_link is not null || Media.Shared ? Variant.Filled : Variant.Text)" Disabled="_busy"
                              aria-label="Share" title="Share by link" aria-expanded="@(_link is not null ? "true" : "false")" Click="ToggleShareAsync" />
                <RadzenButton Icon="push_pin" Variant="@(Media.Pinned ? Variant.Filled : Variant.Text)" Disabled="_busy"
                              aria-label="@(Media.Pinned ? "Unpin" : "Pin")" title="@(Media.Pinned ? "Unpin: let it expire (P)" : "Pin: keep it past 30 days (P)")"
                              aria-pressed="@(Media.Pinned ? "true" : "false")" Click="TogglePinAsync" />
                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Disabled="_busy"
                              aria-label="Delete" title="Delete (Del)" Click="DeleteAsync" />
                @if (MoreItems.Count > 0)
                {
                    <RadzenButton Icon="more_vert" Variant="Variant.Text" aria-label="More actions" title="More actions" aria-haspopup="menu" Click="OpenMore" />
                }
            </span>
        </div>

        @if (_link is not null)
        {
            <section class="panel-share" aria-label="Sharing">
                <RadzenFormField Text="Anyone with this link can view it" class="po-fill">
                    <RadzenTextBox Value="@_link.Url" ReadOnly="true" aria-label="Share link" />
                </RadzenFormField>
                @if (Expiry is { } expiry)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">This item @expiry, and the link stops working with it. Pin the item to keep both.</RadzenText>
                }
                <div class="panel-feed">
                    <RadzenSwitch Name="share-feed" Value="_link.Feed" Change="SetFeedAsync" />
                    <RadzenLabel Component="share-feed" Text="Also post it to the feed, where every signed-in user can see it" />
                </div>
                <div class="panel-share-actions">
                    <RadzenButton Text="Stop sharing" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Disabled="_busy" Click="StopSharingAsync" />
                    <RadzenButton Text="Copy" Icon="content_copy" Size="ButtonSize.Small" Click="@(() => JS.InvokeAsync<bool>("poMedia.copyText", _link.Url))" />
                </div>
            </section>
        }

        <VersionTree Current="Media" Items="Family" Selected="Selected" />
    </RadzenStack>
</RadzenCard>
</aside>

@code {
    [Parameter, EditorRequired] public MediaDto Media { get; set; } = null!;

    /// <summary>Every gallery item. The version tree shows the ones related to this one.</summary>
    [Parameter] public IReadOnlyList<MediaDto> Family { get; set; } = [];

    [Parameter] public EventCallback<MediaDto> Changed { get; set; }
    [Parameter] public EventCallback<MediaDto> Deleted { get; set; }
    [Parameter] public EventCallback<MediaDto> Selected { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string _title = "";
    private bool _busy;
    private bool _comparing;
    private ShareLinkDto? _link;

    /// <summary>The actions only some items have, offered in the "More" menu.</summary>
    private List<ContextMenuItem> MoreItems
    {
        get
        {
            var items = new List<ContextMenuItem>();
            if (Media.Kind == MediaKind.Image)
                items.Add(new() { Text = "Copy the picture", Value = "copy", Icon = "content_copy" });
            if (Media.Kind == MediaKind.Video)
                items.Add(new() { Text = "Download a GIF (uses one run the first time)", Value = "gif", Icon = "gif_box", Disabled = _busy });
            if (Media.Kind == MediaKind.Video && Media.Text is not null)
                items.Add(new() { Text = "Download the roast audio", Value = "roast", Icon = "mic" });
            return items;
        }
    }

    private void OpenMore(MouseEventArgs e) => Menus.Open(e, MoreItems, args => InvokeAsync(async () =>
    {
        Menus.Close();
        switch (args.Value as string)
        {
            case "copy":
                await CopyImageAsync();
                break;
            case "gif":
                await GifAsync();
                break;
            case "roast":
                await JS.InvokeVoidAsync("poMedia.download", $"api/media/{Media.Id}/roast-audio");
                break;
        }
    }));

    /// <summary>The picture this one was made from, when both are pictures: what Compare shows it against.</summary>
    private MediaDto? Before => Media.Kind == MediaKind.Image && Media.ParentId is { } parent
        && Family.FirstOrDefault(m => m.Id == parent) is { Kind: MediaKind.Image } found
            ? found
            : null;

    public void ToggleCompare()
    {
        _comparing = !_comparing && Before is not null;
        StateHasChanged();
    }

    private int _retentionDays;

    /// <summary>When an unpinned item will be removed, in words; null when it is kept.</summary>
    private string? Expiry => Media.Pinned || _retentionDays <= 0
        ? null
        : (Media.CreatedAt.AddDays(_retentionDays) - DateTimeOffset.UtcNow).Days is > 0 and var days
            ? $"expires in {days} {(days == 1 ? "day" : "days")}"
            : "expires within a day";

    protected override async Task OnInitializedAsync()
    {
        _title = Media.Title;
        _retentionDays = (await Config.GetAsync())?.RetentionDays ?? 0;
    }

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    public Task TogglePinAsync() => SaveAsync(null, !Media.Pinned);

    private async Task SaveAsync(string? title, bool? pinned)
    {
        if (_busy)
            return;

        _busy = true;
        var (updated, error) = await Api.UpdateAsync(Media.Id, title, pinned);
        _busy = false;
        if (updated is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not save", error ?? "", 8000);
            _title = Media.Title;
            return;
        }

        await Changed.InvokeAsync(updated);
    }

    public async Task CopyImageAsync()
    {
        if (await JS.InvokeAsync<bool>("poMedia.copyImage", Media.Url))
            Notifications.Notify(NotificationSeverity.Success, "Copied", "The picture is on the clipboard.");
        else
            Notifications.Notify(NotificationSeverity.Error, "Could not copy", "This browser did not allow a picture on the clipboard.", 8000);
    }

    private async Task GifAsync()
    {
        if (_busy)
            return;

        Notifications.Notify(NotificationSeverity.Info, "Making the GIF", "The first time takes a few seconds and uses one run.", 6000);
        _busy = true;
        var error = await Api.MakeGifAsync(Media.Id);
        _busy = false;
        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not make the GIF", error, 8000);
            return;
        }

        await JS.InvokeVoidAsync("poMedia.download", $"api/media/{Media.Id}/gif");
    }

    /// <summary>
    /// Opens the sharing section, making the link if there is none yet (asking again returns the
    /// same one), or closes it. Closing it leaves the link working; Stop sharing ends it.
    /// </summary>
    private async Task ToggleShareAsync()
    {
        if (_link is not null)
        {
            _link = null;
            return;
        }

        _busy = true;
        var (link, error) = await Api.ShareAsync(Media.Id);
        _busy = false;
        if (link is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not share", error ?? "", 8000);
            return;
        }

        _link = link;
        if (!Media.Shared)
            await Changed.InvokeAsync(Media with { Shared = true });
    }

    private async Task SetFeedAsync(bool on)
    {
        if ((await Api.ShareAsync(Media.Id, on)).Link is { } link)
            _link = link;
    }

    private async Task StopSharingAsync()
    {
        _busy = true;
        var error = await Api.StopSharingAsync(Media.Id);
        _busy = false;
        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not stop sharing", error, 8000);
            return;
        }

        _link = null;
        await Changed.InvokeAsync(Media with { Shared = false });
    }

    public async Task DeleteAsync()
    {
        var confirmed = await Dialogs.Confirm(
            $"Delete \"{Media.Title}\"? This cannot be undone.", "Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Keep" });
        if (confirmed != true)
            return;

        _busy = true;
        // Its card in the grid breaks into shards; it comes back if the delete fails.
        var shattered = await JS.InvokeAsync<bool>("poShatter.burst", new[] { Media.Id });
        var error = await Api.DeleteAsync(Media.Id);
        _busy = false;
        if (error is not null)
        {
            await JS.InvokeVoidAsync("poShatter.restore", new[] { Media.Id });
            Notifications.Notify(NotificationSeverity.Error, "Could not delete", error, 8000);
            return;
        }

        if (!shattered)
            await JS.InvokeVoidAsync("poSfx.play", "remove");
        await Deleted.InvokeAsync(Media);
    }
}
