@* The two places to go: Create, and the Library. Drawn twice by the
   layout, in the header on wide screens and as a tab bar at the bottom on phones. *@
@implements IDisposable
@inject NavigationManager Navigation

<nav class="@Class" aria-label="@Label">
    <a href="" class="@(InLibrary ? null : "active")" aria-current="@(InLibrary ? null : "page")">
        <RadzenIcon Icon="auto_awesome" aria-hidden="true" /><span>Create</span>
    </a>
    <a href="gallery" class="@(InLibrary ? "active" : null)" aria-current="@(InLibrary ? "page" : null)">
        <RadzenIcon Icon="photo_library" aria-hidden="true" /><span>Library</span>
    </a>
    @ChildContent
</nav>

@code {
    private static readonly string[] LibraryPaths = ["gallery", "library"];

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool InLibrary => LibraryPaths.Contains(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#', '/')[0]);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
