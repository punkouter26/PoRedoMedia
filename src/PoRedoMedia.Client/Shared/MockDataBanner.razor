@inject AppConfigService Config

@if (_useMockAi)
{
    @* A thin strip rather than an alert: it is always there in tests, and must not cost the page a row. *@
    <div class="po-mock-strip" role="status">
        <RadzenIcon Icon="science" aria-hidden="true" />
        Using mock data. No AI provider is being called; results are placeholders.
    </div>
}

@code {
    private bool _useMockAi;

    protected override async Task OnInitializedAsync() => _useMockAi = (await Config.GetAsync())?.UseMockAi == true;
}
