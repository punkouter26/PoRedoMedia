@* Choosing the media for a run: drop, paste, pick a file, use the camera, take a file another
   app shared, or reuse something already in the gallery. *@
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject MediaApi Api
@inject BlobUploadService Uploader
@inject AppConfigService Config
@inject IJSRuntime JS

<RadzenStack Gap="1rem">
    <div class="picker-drop" @ref="_zone">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Choose a photo or a video</RadzenText>
        <RadzenText class="rz-m-0">Drop it here, paste it, pick a file, or use the camera.</RadzenText>
        <RadzenText class="rz-m-0">JPG, PNG, WEBP or GIF up to 10 MB. MP4, MOV or WEBM up to 200 MB and 10 minutes.</RadzenText>
        <FilePick @ref="_file" Text="Choose file" Disabled="Busy" OnChange="UploadAsync" />
        @if (_hasCamera && !_cameraOn)
        {
            <RadzenButton Text="Use the camera" Icon="photo_camera" Variant="Variant.Outlined" Disabled="Busy" Click="StartCameraAsync" />
        }
        <video @ref="_camera" class="picker-camera" hidden="@(!_cameraOn)" playsinline muted aria-label="Camera preview"></video>
        @if (_cameraOn)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Take the photo" Icon="camera" Click="TakePhotoAsync" />
                <RadzenButton Text="Cancel" Variant="Variant.Outlined" Click="StopCameraAsync" />
            </RadzenStack>
        }
        @if (_percent is { } percent)
        {
            <RadzenProgressBar Value="percent" aria-label="Upload progress" class="po-fill" />
        }
        @if (_status is not null)
        {
            <RadzenText class="rz-m-0" aria-live="polite">@_status</RadzenText>
        }
        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">@_error</RadzenAlert>
        }
    </div>

    @if (ShowRecent && _recent.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H2" class="rz-m-0">Or use something from your gallery</RadzenText>
        <div class="picker-recent">
            @foreach (var item in _recent)
            {
                var media = item;
                <button type="button" class="picker-card" disabled="@Busy" @onclick="@(() => ValueChanged.InvokeAsync(media))">
                    <img src="@media.ThumbUrl" alt="" loading="lazy" />
                    <span>@media.Title</span>
                </button>
            }
        </div>
    }
</RadzenStack>

@code {
    [Parameter] public EventCallback<MediaDto> ValueChanged { get; set; }

    /// <summary>Offer recent gallery items below the drop zone. Off where the gallery is already on screen.</summary>
    [Parameter] public bool ShowRecent { get; set; } = true;

    /// <summary>Another app shared a file to this one: pick it up as if it had been chosen here.</summary>
    [Parameter] public bool TakeShared { get; set; }

    private List<MediaDto> _recent = [];
    private double? _percent;
    private string? _error;
    private string? _status;
    private FilePick? _file;

    private ElementReference _zone;
    private ElementReference _camera;
    private bool _hasCamera;
    private bool _cameraOn;
    private bool _rendered;

    private bool Busy => _percent is not null || _status is not null;

    protected override async Task OnInitializedAsync()
    {
        if (ShowRecent)
            _recent = [.. (await Api.ListAsync()).Where(m => m.Kind != MediaKind.Audio).Take(12)];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _rendered = true;
        await JS.InvokeVoidAsync("poMedia.acceptDropAndPaste", _zone, _file!.Element);
        _hasCamera = await JS.InvokeAsync<bool>("poMedia.hasCamera");
        StateHasChanged();
        if (TakeShared)
            await JS.InvokeAsync<bool>("poMedia.takeShared", _file.Element);
    }

    private async Task StartCameraAsync()
    {
        _cameraOn = await JS.InvokeAsync<bool>("poMedia.startCamera", _camera);
        _error = _cameraOn ? null : "The camera could not be opened. Check that this site is allowed to use it.";
    }

    private async Task TakePhotoAsync()
    {
        // The photo arrives through the file input, exactly as a chosen file does.
        await JS.InvokeAsync<bool>("poMedia.takePhoto", _camera, _file!.Element);
        _cameraOn = false;
    }

    private async Task StopCameraAsync()
    {
        await JS.InvokeVoidAsync("poMedia.stopCamera", _camera);
        _cameraOn = false;
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        // A second file chosen while the first is still going is ignored.
        if (Busy)
            return;

        (_percent, _error) = (0, null);
        var input = _file!.Element;
        var (media, error) = await Uploader.UploadAsync(input, e.File.Name, e.File.Size, percent =>
        {
            _percent = percent;
            InvokeAsync(StateHasChanged);
        });
        (_percent, _error) = (null, error);

        if (media is { Kind: MediaKind.Video })
        {
            // Analysed once, here, while the browser still has the file. Every later run reuses it.
            _status = "Looking through the video…";
            StateHasChanged();
            await JS.InvokeAsync<int>("poMedia.analyseVideo", input, media.Id);

            // No speech model on the server: the browser's own hears the video instead.
            if ((await Config.GetAsync())?.ServerSpeech == false)
            {
                _status = "Listening to the video on your device…";
                StateHasChanged();
                using var progress = DotNetObjectReference.Create(new BlobUploadService.ProgressSink(percent =>
                {
                    _status = percent >= 0 ? $"Getting the on-device speech model ready: {percent}%" : "Listening to the video on your device…";
                    InvokeAsync(StateHasChanged);
                }));
                await JS.InvokeAsync<int>("poMedia.transcribeVideo", input, media.Id, progress);
            }

            _status = null;
        }

        // Emptied, so choosing the same file again is a change the input reports.
        await JS.InvokeVoidAsync("poMedia.clearFile", input);
        if (media is not null)
            await ValueChanged.InvokeAsync(media);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_rendered)
            return;

        try
        {
            // Leaving the page must turn the camera off and take the paste listener with it.
            await JS.InvokeVoidAsync("poMedia.stopCamera", _camera);
            await JS.InvokeVoidAsync("poMedia.releaseDropAndPaste", _zone);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; so are the camera and the listeners.
        }
    }
}
