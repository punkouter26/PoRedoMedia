<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoRedoMedia.Mobile.ViewModels"
             xmlns:conv="clr-namespace:PoRedoMedia.Mobile.Converters"
             x:Class="PoRedoMedia.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0B0F19">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:NullToFalseConverter x:Key="NullToFalseConverter" />
            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

            <Color x:Key="BgDark">#0B0F19</Color>
            <Color x:Key="BgCard">#161F30</Color>
            <Color x:Key="BgCardHover">#1E293B</Color>
            <Color x:Key="Primary">#3B82F6</Color>
            <Color x:Key="PrimaryDark">#1D4ED8</Color>
            <Color x:Key="AccentPurple">#8B5CF6</Color>
            <Color x:Key="AccentPink">#EC4899</Color>
            <Color x:Key="AccentAmber">#F59E0B</Color>
            <Color x:Key="AccentEmerald">#10B981</Color>
            <Color x:Key="TextPrimary">#F8FAFC</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="BorderLight">#334155</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <!-- ── Top Header ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,8">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="POREDO"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           CharacterSpacing="1.5" />
                    <Label Text="Instant AI Photo Studio"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Reset"
                        Command="{Binding ResetCommand}"
                        IsVisible="{Binding HasPhoto}"
                        BackgroundColor="{StaticResource BgCard}"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="12"
                        Padding="12,6"
                        HeightRequest="36"
                        CornerRadius="8" />
            </Grid>

            <!-- ── Error Banner ────────────────────────────────────── -->
            <Frame BackgroundColor="#3F1D24"
                   BorderColor="#7F1D1D"
                   CornerRadius="10"
                   Padding="12,10"
                   IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FCA5A5"
                       FontSize="12"
                       LineBreakMode="WordWrap" />
            </Frame>

            <!-- ── Viewport / Photo Intake Box ──────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16"
                    MinimumHeightRequest="240">

                <Grid>
                    <!-- State A: Empty Intake / Camera Launcher -->
                    <VerticalStackLayout IsVisible="{Binding HasPhoto, Converter={StaticResource InverseBoolConverter}}"
                                         Spacing="14"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">

                        <Frame WidthRequest="72"
                               HeightRequest="72"
                               CornerRadius="36"
                               BackgroundColor="#1E293B"
                               BorderColor="{StaticResource Primary}"
                               Padding="0"
                               HorizontalOptions="Center">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                            </Frame.GestureRecognizers>
                            <Label Text="📸"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="Take or Select a Picture"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <Label Text="Camera photos are automatically resized for rapid AI processing."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"
                               MaximumWidthRequest="260" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,6,0,0">
                            <Button Text="📷 Snap Photo"
                                    Command="{Binding TakePhotoCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HeightRequest="44"
                                    Padding="16,8" />

                            <Button Text="📁 Gallery"
                                    Command="{Binding PickPhotoCommand}"
                                    BackgroundColor="{StaticResource BgCardHover}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource BorderLight}"
                                    BorderWidth="1"
                                    HeightRequest="44"
                                    Padding="16,8" />

                            <Button Text="🎯 Pro shot"
                                    Clicked="OnProShotClicked"
                                    BackgroundColor="{StaticResource BgCardHover}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource BorderLight}"
                                    BorderWidth="1"
                                    HeightRequest="44"
                                    Padding="16,8" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- State B: Captured Image Preview -->
                    <VerticalStackLayout IsVisible="{Binding HasPhoto}" Spacing="10">
                        <Frame CornerRadius="12"
                               Padding="0"
                               IsClippedToBounds="True"
                               BorderColor="{StaticResource BorderLight}"
                               HeightRequest="240"
                               BackgroundColor="#000000">
                            <Image Source="{Binding PhotoImageSource}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                        </Frame>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding PhotoSummary}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Button Text="Retake"
                                        Command="{Binding TakePhotoCommand}"
                                        BackgroundColor="{StaticResource BgCardHover}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        Padding="10,4"
                                        HeightRequest="30" />
                                <Button Text="Choose"
                                        Command="{Binding PickPhotoCommand}"
                                        BackgroundColor="{StaticResource BgCardHover}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        Padding="10,4"
                                        HeightRequest="30" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ── Quick Processing Actions (4 Minimalist Tiles) ────── -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPhoto}">
                <Label Text="QUICK ACTIONS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       CharacterSpacing="1" />

                <!-- Grid of 6 actions -->
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">

                    <!-- Tile 1: Meme -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProcessMemeCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🎭" FontSize="24" />
                            <Label Text="Make Meme" FontSize="14" FontAttributes="Bold" />
                            <Label Text="AI caption overlay" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tile 2: Reimagine -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProcessRegenerateCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="✨" FontSize="24" />
                            <Label Text="Reimagine" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Style transform" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tile 3: Rap Roast -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProcessRapRoastCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🎤" FontSize="24" />
                            <Label Text="Rap Roast" FontSize="14" FontAttributes="Bold" />
                            <Label Text="16 savage bars" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tile 5: Bulk ×10 -->
                    <Border Grid.Row="2" Grid.Column="0"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource AccentPurple}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProcessBulkCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🎨" FontSize="24" />
                            <Label Text="Bulk ×10" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Ten art styles at once" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tile 6: Video -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource AccentPink}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProcessVideoCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🎬" FontSize="24" />
                            <Label Text="Video" FontSize="14" FontAttributes="Bold" />
                            <Label Text="8s Veo clip" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Video prompt: what should happen in the clip -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="VIDEO PROMPT"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="#0F172A"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,4">
                        <Editor Text="{Binding VideoPrompt}"
                                Placeholder="Describe what should happen in the clip…"
                                AutoSize="TextChanges"
                                MaxLength="1200"
                                FontSize="12"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextSecondary}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Live Processing Stage ────────────────────────────── -->
            <Border IsVisible="{Binding IsProcessing}"
                    BackgroundColor="#131D31"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ProcessingStage}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <ActivityIndicator Grid.Column="1"
                                           IsRunning="{Binding IsProcessing}"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="20"
                                           HeightRequest="20" />
                    </Grid>
                    <ProgressBar Progress="{Binding ProcessingProgress}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="4" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Result Card ─────────────────────────────────────── -->
            <Border IsVisible="{Binding HasResult}"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource AccentEmerald}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding ResultTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- Image Result if present -->
                    <Frame CornerRadius="10"
                           Padding="0"
                           IsClippedToBounds="True"
                           BorderColor="{StaticResource BorderLight}"
                           HeightRequest="260"
                           BackgroundColor="#000000"
                           IsVisible="{Binding ResultImageSource, Converter={StaticResource NullToFalseConverter}}">
                        <Image Source="{Binding ResultImageSource}"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                    </Frame>

                    <!-- Bulk board: slots fill in live as the stream lands -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBulkResult}">
                        <Label Text="{Binding BulkSummary}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentPurple}" />
                        <CollectionView ItemsSource="{Binding BulkItems}"
                                        SelectionMode="None"
                                        HeightRequest="170">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkItemViewModel">
                                    <Border WidthRequest="120"
                                            BackgroundColor="#0F172A"
                                            Stroke="{StaticResource BorderLight}"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="4">
                                        <Grid RowDefinitions="*,Auto" RowSpacing="2">
                                            <Image Grid.Row="0"
                                                   Source="{Binding Image}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding IsFilled}" />
                                            <Label Grid.Row="0"
                                                   Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding IsFilled, Converter={StaticResource InverseBoolConverter}}" />
                                            <Label Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Video result actions -->
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsVideoResult}">
                        <Button Text="▶️ Open Clip"
                                Command="{Binding OpenVideoClipCommand}"
                                IsVisible="{Binding VideoReady}"
                                BackgroundColor="{StaticResource AccentPink}"
                                TextColor="White"
                                FontSize="12"
                                Padding="12,6" />
                        <Label Text="8s · with sound · saved locally when shared"
                               FontSize="10"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Text / Lyrics Result -->
                    <Border BackgroundColor="#0F172A"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding ResultText, Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="{Binding ResultText}"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <!-- Where the caption was generated -->
                    <Label Text="{Binding CaptionSourceNote}"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding CaptionSourceNote, Converter={StaticResource StringNotEmptyConverter}}" />

                    <!-- Result Action Buttons -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="📤 Share"
                                Command="{Binding ShareResultCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontSize="12"
                                Padding="8" />

                        <Button Grid.Column="1"
                                Text="💾 Save"
                                Command="{Binding SaveResultCommand}"
                                BackgroundColor="{StaticResource BgCardHover}"
                                TextColor="{StaticResource TextPrimary}"
                                BorderColor="{StaticResource BorderLight}"
                                BorderWidth="1"
                                FontSize="12"
                                Padding="8" />

                        <Button Grid.Column="2"
                                Text="🔄 Snap New"
                                Command="{Binding TakePhotoCommand}"
                                BackgroundColor="{StaticResource AccentEmerald}"
                                TextColor="White"
                                FontSize="12"
                                Padding="8" />
                    </Grid>

                    <Label Text="{Binding GalleryStatus}"
                           FontSize="11"
                           TextColor="{StaticResource AccentEmerald}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding HasGalleryStatus}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

