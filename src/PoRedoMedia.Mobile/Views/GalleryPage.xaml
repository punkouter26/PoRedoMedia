<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoRedoMedia.Mobile.ViewModels"
             xmlns:conv="clr-namespace:PoRedoMedia.Mobile.Converters"
             x:Class="PoRedoMedia.Mobile.Views.GalleryPage"
             x:DataType="vm:GalleryViewModel"
             Title="My Gallery"
             BackgroundColor="#0B0F19">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:NullToFalseConverter x:Key="NullToFalseConverter" />

            <Color x:Key="BgCard">#161F30</Color>
            <Color x:Key="Primary">#3B82F6</Color>
            <Color x:Key="AccentRed">#EF4444</Color>
            <Color x:Key="TextPrimary">#F8FAFC</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="BorderLight">#334155</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="16,12"
          RowSpacing="10">

        <Label Grid.Row="0"
               Text="GALLERY &amp; ASSETS"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               CharacterSpacing="1" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="↻ Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource BgCard}"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="12"
                    Padding="12,6"
                    HeightRequest="34"
                    CornerRadius="8" />
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"
                                 VerticalItemSpacing="8" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:GalleryItemViewModel">
                    <Border BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource BorderLight}"
                            StrokeShape="RoundRectangle 10"
                            Padding="6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GalleryViewModel}}, Path=OpenCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="120,Auto" RowSpacing="4">
                            <Image Grid.Row="0"
                                   Source="{Binding Image}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding IsLoaded}" />
                            <Label Grid.Row="0"
                                   Text="…"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsLoaded, Converter={StaticResource InverseBoolConverter}}" />
                            <VerticalStackLayout Grid.Row="1" Spacing="1">
                                <Label Text="{Binding KindLabel}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding CreatedLabel}"
                                       FontSize="9"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🖼️" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="No images yet"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="Save a meme, artwork, or bulk variation from the studio tab and it will appear here — on this phone and in the web gallery."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"
                           MaximumWidthRequest="300" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Label Grid.Row="3"
               Text="Saved originals and results sync with the web app's gallery."
               FontSize="10"
               TextColor="{StaticResource TextSecondary}" />

        <!-- Biometric lock overlay: hardware gate a browser cannot provide. -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                BackgroundColor="#F20B0F19"
                Stroke="{StaticResource BorderLight}"
                StrokeShape="RoundRectangle 16"
                Padding="24"
                IsVisible="{Binding IsLocked}">
            <VerticalStackLayout VerticalOptions="Center"
                                 Spacing="14"
                                 HorizontalOptions="Center">
                <Label Text="🔐"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="Gallery locked"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center" />
                <Label Text="Unlock with your fingerprint or face to view your saved creations."
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="280" />
                <Button Text="🔓 Unlock"
                        Command="{Binding UnlockCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        HeightRequest="44"
                        CornerRadius="10"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Detail overlay: tap a tile to inspect, delete, or close. -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                BackgroundColor="#E60B0F19"
                Stroke="{StaticResource BorderLight}"
                StrokeShape="RoundRectangle 16"
                Padding="16"
                IsVisible="{Binding Selected, Converter={StaticResource NullToFalseConverter}}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding Selected.FileName}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Button Grid.Column="1"
                            Text="✕ Close"
                            Command="{Binding CloseDetailCommand}"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="11"
                            Padding="10,4"
                            HeightRequest="30"
                            CornerRadius="8" />
                </Grid>

                <Image Grid.Row="1"
                       Source="{Binding Selected.Image}"
                       Aspect="AspectFit" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding Selected.SizeLabel}"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="💾 Save to Photos"
                            Command="{Binding SaveToDeviceCommand}"
                            CommandParameter="{Binding Selected}"
                            BackgroundColor="{StaticResource BgCardHover}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="12"
                            Padding="12,6" />
                    <Button Grid.Column="2"
                            Text="🗑 Delete"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding Selected}"
                            BackgroundColor="{StaticResource AccentRed}"
                            TextColor="White"
                            FontSize="12"
                            Padding="12,6" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
